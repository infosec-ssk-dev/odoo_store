<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_digiit_autorisation_list" model="ir.ui.view">
        <field name="name">digiit.autorisation.list</field>
        <field name="model">digiit.autorisation</field>
        <field name="arch" type="xml">
            <list string="Autorisations Suspension TVA">
                <field name="partner_id"/>
                <field name="num_autorisation"/>
                <field name="type_autorisation"/>
                <field name="date_debut"/>
                <field name="date_effet"/>
                <field name="date_fin"/>
            </list>
        </field>
    </record>

    <record id="view_digiit_autorisation_form" model="ir.ui.view">
        <field name="name">digiit.autorisation.form</field>
        <field name="model">digiit.autorisation</field>
        <field name="arch" type="xml">
            <form string="Autorisation Suspension TVA">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="num_autorisation"/>
                            <field name="type_autorisation"/>
                        </group>
                        <group>
                            <field name="date_debut"/>
                            <field name="date_effet"/>
                            <field name="date_fin"/>
                        </group>
                    </group>
                    <group string="Pièce jointe">
                        <field name="attachment" widget="binary"
                               filename="attachment_filename"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_digiit_autorisation" model="ir.actions.act_window">
        <field name="name">Autorisations Suspension TVA</field>
        <field name="res_model">digiit.autorisation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
