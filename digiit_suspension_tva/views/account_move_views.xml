<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_digiit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.digiit.suspension.tva</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='due_date']" position="after">
                <!-- technical -->
                <field name="digiit_suspension_tva_active" invisible="1"/>
                <!-- fiscal position moved here -->
                <xpath expr="//field[@name='fiscal_position_id']" position="move"/>
                <!-- autorisation -->
                <field name="digiit_autorisation_id"
                       string="Num Autorisation"
                       invisible="not digiit_suspension_tva_active"
                       domain="[('partner_id', '=', partner_id)]"
                       options="{'no_create': true, 'no_open': true}"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>