
<odoo>
    <record id="impacted_security_criteria_view_list" model="ir.ui.view">
        <field name="name">Liste des critères de sécurité impactés</field>
        <field name="model">digiit.ebios_rm.security.criteria</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="Nom"/>
            </list>
        </field>  
    </record>
    <record id="impacted_security_criteria_view_form" model="ir.ui.view">
        <field name="name">Formulaire critères de sécurité impactés</field>
        <field name="model">digiit.ebios_rm.security.criteria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nom"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_impacted_security_criteria_list_view" model="ir.actions.act_window">
        <field name="name">Critères de sécurité impactés</field>
        <field name="res_model">digiit.ebios_rm.security.criteria</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="impacted_security_criteria_view_list"/>
    </record>

    
    <menuitem
        id="impacted_security_criteria_menu_item"
        name="Critères de sécurité Impactés"
        parent="main_menu"
        action="action_impacted_security_criteria_list_view"
        />
</odoo>