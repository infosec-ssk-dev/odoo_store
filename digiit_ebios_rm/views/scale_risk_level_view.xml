
<odoo>
    <record id="scale_risk_level_view_list" model="ir.ui.view">
        <field name="name">Scale Risk Level list</field>
        <field name="model">digiit.ebios_rm.scale.risk.level</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="name" string="Nom"/>
                <field name="description" string="Description"/>
            </list>
        </field>  
    </record>
    <record id="scale_risk_level_view_form" model="ir.ui.view">
        <field name="name">scale_risk_level Form</field>
        <field name="model">digiit.ebios_rm.scale.risk.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="description" string="Description"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_scale_risk_level_list_view" model="ir.actions.act_window">
        <field name="name">Scale Risk Levels</field>
        <field name="res_model">digiit.ebios_rm.scale.risk.level</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="scale_risk_level_view_list"/>
    </record>

    
