
<odoo>
    <record id="bv_description_activity_view_list" model="ir.ui.view">
        <field name="name">Digiit Bv Description Activity list</field>
        <field name="model">digiit.ebios_rm.bv.description.activity</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="name" string=""/>
            </list>
        </field>  
    </record>
    <record id="bv_description_activity_view_form" model="ir.ui.view">
        <field name="name">bv_description_activity Form</field>
        <field name="model">digiit.ebios_rm.bv.description.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string=""/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_bv_description_activity_list_view" model="ir.actions.act_window">
        <field name="name">Digiit Bv Description Activitys</field>
        <field name="res_model">digiit.ebios_rm.bv.description.activity</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="bv_description_activity_view_list"/>
    </record>

    
    <!-- <menuitem
        id="bv_description_activity_menu_item"
