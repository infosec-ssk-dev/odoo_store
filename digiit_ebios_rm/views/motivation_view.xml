
<odoo>
    <record id="motivation_view_list" model="ir.ui.view">
        <field name="name">Motivation list</field>
        <field name="model">digiit.ebios_rm.motivation</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom">
                <field name="number" string="Niveau"/>
                <field name="name" string="Nom"/>
                <field name="color" widget="color"/>
            </list>
        </field>  
    </record>
    <record id="motivation_view_form" model="ir.ui.view">
        <field name="name">motivation Form</field>
        <field name="model">digiit.ebios_rm.motivation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="number" string="Niveau"/>
                        <field name="name" string="Nom"/>
                        <field name="color" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_motivation_list_view" model="ir.actions.act_window">
        <field name="name">Motivations</field>
        <field name="res_model">digiit.ebios_rm.motivation</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="motivation_view_list"/>
    </record>

    
    <menuitem
        id="motivation_menu_item"
        name="Motivations"
        parent="pertinence_src_risk"
        action="action_motivation_list_view"
        sequence="10"
        />
</odoo>