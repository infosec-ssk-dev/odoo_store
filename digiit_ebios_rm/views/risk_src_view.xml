
<odoo>
    <record id="risk_src_view_list" model="ir.ui.view">
        <field name="name">Risk Src list</field>
        <field name="model">digiit.ebios_rm.risk.src</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom">
                <field name="name" string="Profile d'attaquant"/>
                <field name="description" string="Exemples et modes opératoires habituels"/>
                <field name="image" string="Image"/>
                <field name="target_objective_ids" string="Objectif visé" widget="many2many_tags" options="{'no_create': True}"/>
            </list>
        </field>  
    </record>
    <record id="risk_src_view_form" model="ir.ui.view">
        <field name="name">risk_src Form</field>
        <field name="model">digiit.ebios_rm.risk.src</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Profile d'attaquant"/>
                        <field name="description" string="Exemples et modes opératoires habituels"/>
                        <field name="target_objective_ids" string="Objectif visé" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_risk_src_list_view" model="ir.actions.act_window">
        <field name="name">Sources de risques</field>
        <field name="res_model">digiit.ebios_rm.risk.src</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="risk_src_view_list"/>
    </record>

    
    <menuitem
        id="risk_src_menu_item"
        name="Source de risque"
        parent="sr_ov"
        sequence="20"
        action="action_risk_src_list_view"
        />
</odoo>