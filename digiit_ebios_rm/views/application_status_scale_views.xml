
<odoo>
    <record id="application_status_scale_view_list" model="ir.ui.view">
        <field name="name">Application Status Scale list</field>
        <field name="model">digiit.ebios_rm.application.status.scale</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="level" string="Niveau"/>
                <field name="name" string="Nom"/>
                <field name="color" string="Couleur" widget="color"/>
                <field name="description" string="Description"/>
            </list>
        </field>
    </record>
    <record id="application_status_scale_view_form" model="ir.ui.view">
        <field name="name">Application Status Scale Form</field>
        <field name="model">digiit.ebios_rm.application.status.scale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="level" string="Niveau"/>
                        <field name="name" string="Nom"/>
                        <field name="color" string="Couleur" widget="color"/>
                        <field name="description" string="Description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_application_status_scale_list_view" model="ir.actions.act_window">
        <field name="name">Gestion des niveaux d'état d'application</field>
        <field name="res_model">digiit.ebios_rm.application.status.scale</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="application_status_scale_view_list"/>
    </record>


    <menuitem
        id="application_status_scale_menu_item"
        name="Niveaux d'état d'application"
        parent="referential"
        sequence="20"
        action="action_application_status_scale_list_view"
        />
</odoo>