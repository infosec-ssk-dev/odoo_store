
<odoo>
    <record id="data_view_list" model="ir.ui.view">
        <field name="name">Digiit Data list</field>
        <field name="model">digiit.ebios_rm.data</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="name" string=""/>
            </list>
        </field>  
    </record>
    <record id="data_view_form" model="ir.ui.view">
        <field name="name">data Form</field>
        <field name="model">digiit.ebios_rm.data</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string=""/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_data_list_view" model="ir.actions.act_window">
        <field name="name">Digiit Datas</field>
        <field name="res_model">digiit.ebios_rm.data</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="data_view_list"/>
    </record>

    
    <!-- <menuitem
        id="data_menu_item"
        name="Données"
        parent="main_menu"
        action="action_data_list_view"
        /> -->
</odoo>