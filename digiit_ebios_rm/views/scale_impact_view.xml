
<odoo>
    <record id="scale_impact_view_list" model="ir.ui.view">
        <field name="name">Echelle d'impact</field>
        <field name="model">digiit.ebios_rm.scale.impact</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom">
                <field name="name" string="Nom"/>
                <field name="description" string="Description"/>
            </list>
        </field>  
    </record>
    <record id="scale_impact_view_form" model="ir.ui.view">
        <field name="name">scale_impact Form</field>
        <field name="model">digiit.ebios_rm.scale.impact</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <group>
                                <field name="name" string="Nom"/>
                            </group>
                        </h1>
                    </div>
                    <group>
                        <field name="name" string="Nom"/>
                        <field name="description" string="Description"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_scale_impact_list_view" model="ir.actions.act_window">
        <field name="name">Echelle d'impact</field>
        <field name="res_model">digiit.ebios_rm.scale.impact</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="scale_impact_view_list"/>
    </record>

    
    <!-- <menuitem
        id="scale_impact_menu_item"
        name="Echelle d'impact"
        parent="échelles"
        action="action_scale_impact_list_view"
        /> -->
</odoo>