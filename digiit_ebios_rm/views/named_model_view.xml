
<odoo>
    <record id="named_model_view_list" model="ir.ui.view">
        <field name="name">Named Model list</field>
        <field name="model">digiit.ebios_rm.named.model</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="name" string="Nom"/>
                <field name="number" string="ID"/>
            </list>
        </field>  
    </record>
    <record id="named_model_view_form" model="ir.ui.view">
        <field name="name">named_model Form</field>
        <field name="model">digiit.ebios_rm.named.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nom"/>
                        <field name="number" string="ID"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_named_model_list_view" model="ir.actions.act_window">
        <field name="name">Named Models</field>
        <field name="res_model">digiit.ebios_rm.named.model</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="named_model_view_list"/>
    </record>
</odoo>