
<odoo>
    <record id="risk_treatment_view_list" model="ir.ui.view">
        <field name="name">Risk Treatment list</field>
        <field name="model">digiit.ebios_rm.risk.treatment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="identifier" string="Risque" optional="show"/>
                <field name="dreaded_event" string="Evénements redouté" optional="show"/>
                <field name="business_value" string="Valeur métier" optional="show"/>
                <field name="attack_path" string="Description du chemin d'attaque" optional="show"/>
                <field name="severity" string="Gravité" optional="show" class="o_centered_column"/>
                <field name="likelihood" string="Vraisemblance" optional="show" class="o_centered_column"/>
                <field name="risk_level" string="Niveau de risque" optional="show" class="o_centered_column"/>
                <field name="treatment_strategy" string="Options de traitement (6.1.3.a)" optional="show"/>
                <field name="treatment_measures" optional="show"/>
                <field name="probability_treatment_mesures" optional="show"/>
                <field name="equivalent_mesures_referentiel" widget="many2many_tags" optional="show"/>
                <field name="risidual_severity" string="Gravité risiduelle" optional="show" class="o_centered_column"/>
                <field name="risidual_likelihood" string="Vraisemblance risiduelle" optional="show" class="o_centered_column"/>
                <field name="risidual_risk_level" string="Niveau de risque risiduel"  optional="show" class="o_centered_column"/>
                <field name="risidual_treatment_strategy" string="Stratégie de traitement" optional="show"/>
                <field name="risk_owner" string="Propriétaire de risque" optional="show"/>
                <field name="owner_validation_date" string="Date de validation de propriétaire" optional="show"/>
                <field name="justification" string="Justification" optional="show"/>
                <field name="observations" string="Observations" optional="show"/>

            </list>
        </field>  
    </record>
    <record id="risk_treatment_view_form" model="ir.ui.view">
        <field name="name">risk_treatment Form</field>
        <field name="model">digiit.ebios_rm.risk.treatment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="risk_id" string="Risque"/>
                        <field name="dreaded_event" string="Evénements redouté"/>
                        <field name="business_value" string="Valeur métier"/>
                        <field name="attack_path" string="Description du chemin d'attaque"/>
                        <field name="severity" string="Gravité"/>
                        <field name="likelihood" string="Vraisemblance"/>
                        <field name="risk_level" string="Niveau de risque"/>
                        <field name="treatment_strategy" string="Treatement strategy"/>
                        <field name="treatment_measures" string="Risk treatment measures over the probality (preventives, deterrents)"/>
                        <field name="risidual_severity" string="Gravité résiduelle"/>
                        <field name="risidual_likelihood" string="Niveau de risque résiduel"/>
                        <field name="risidual_treatment_strategy" string="Stratégie de traitement"/>
                        <field name="risk_owner" string="Propriétaire de risque"/>
                        <field name="owner_validation_date" string="Date de validation de propriétaire"/>
                        <field name="justification" string="Justification"/>
                        <field name="observations" string="Observations"/>
                    </group>
                    <field name="risidual_risk_level" string=""/>
                    <field name="probability_treatment_mesures"/>
                    <field name="equivalent_mesures_referentiel" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="risk_treatment_search_view" model="ir.ui.view">
        <field name="name">Risk Treatment Search</field>
        <field name="model">digiit.ebios_rm.risk.treatment</field>
        <field name="arch" type="xml">
            <search>
                <!-- SEARCHABLE FIELDS -->
                <field name="identifier" string="Risque"/>
                <field name="dreaded_event" string="Evènement redouté"/>
                <field name="business_value" string="Valeur métier"/>
                <field name="risk_owner" string="Propriétaire de risque"/>
                <field name="treatment_strategy" string="Stratégie"/>

                <!-- Validation filters -->
                <filter name="validated" string="Validé"
                        domain="[('owner_validation_date','!=',False)]"/>

                <filter name="not_validated" string="Non validé"
                        domain="[('owner_validation_date','=',False)]"/>

                <!-- Hidden study filter -->
                <filter name="study_filter" string="Étude en cours"
                        domain="[('study_id','=',context.get('default_study_id'))]"
                        invisible="1"/>

                <separator/>

                <!-- GROUP BY -->
                <group expand="0" string="Group By">
                    <filter name="group_by_er" string="Evénement redouté"
                            context="{'group_by':'dreaded_event'}"/>
                    <filter name="group_by_business_value" string="Valeur métier"
                            context="{'group_by':'business_value'}"/>
                    <filter name="group_by_strategy" string="Stratégie"
                            context="{'group_by':'treatment_strategy'}"/>
                    <filter name="group_by_owner" string="Propriétaire de risque"
                            context="{'group_by':'risk_owner'}"/>
                    <filter name="group_by_severity" string="Gravité"
                            context="{'group_by':'severity'}"/>
                    <filter name="group_by_likelihood" string="Vraisemblance"
                            context="{'group_by':'likelihood'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_risk_treatment_list_view" model="ir.actions.act_window">
        <field name="name">Traitement des Risques</field>
        <field name="res_model">digiit.ebios_rm.risk.treatment</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="view_id" ref="risk_treatment_view_list"/>
        <field name="domain">[('study_id', '=', active_id)]</field>
        <field name="context">{'default_study_id': active_id}</field>
    </record>

    
    <!-- <menuitem
        id="risk_treatment_menu_item"
        name=" Traitement du risque"
        parent="main_menu"
        action="action_risk_treatment_list_view"
        /> -->
</odoo>