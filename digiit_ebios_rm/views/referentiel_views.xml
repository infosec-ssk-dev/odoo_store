<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Referential Views -->
    <record id="referential_view_list" model="ir.ui.view">
        <field name="name">digiit.ebios_rm.referential.list</field>
        <field name="model">digiit.ebios_rm.referential</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="version"/>
                <field name="chapter_count"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="referential_view_form" model="ir.ui.view">
        <field name="name">digiit.ebios_rm.referential.form</field>
        <field name="model">digiit.ebios_rm.referential</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="version"/>
                    </group>
                    <group>
                        <field name="description" placeholder="Description du référentiel..."/>
                    </group>
                    <group>
                        <field name="chapter_ids" string="Chapitres" context="{'default_referential_id': id}">
                            <list>
                                <field name="chapter_id"/>
                                <field name="chapter_title"/>
                                <field name="measure_count"/>
                                <field name="description"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Chapter Views -->
    <record id="referential_chapter_view_form" model="ir.ui.view">
        <field name="name">digiit.ebios_rm.referential.chapter.form</field>
        <field name="model">digiit.ebios_rm.referential.chapter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="referential_id"/>
                            <field name="chapter_id"/>
                            <field name="chapter_title"/>
                        </group>
                        <group>
                            <field name="measure_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description du chapitre..."/>
                    </group>
                    <group>
                        <field name="measure_ids" string="Mesures" context="{'default_chapter_id': id}">
                            <list>
                                <field name="measure_id"/>
                                <field name="measure_title"/>
                                <field name="contenu"/>
                                <field name="question_count"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Measure Views -->
    <record id="referential_measure_view_form" model="ir.ui.view">
        <field name="name">digiit.ebios_rm.referential.measure.form</field>
        <field name="model">digiit.ebios_rm.referential.measure</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="chapter_id"/>
                            <field name="measure_id"/>
                            <field name="measure_title"/>
                            <field name="contenu"/>
                        </group>
                        <group>
                            <field name="question_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="question_ids" string="Questions" context="{'default_measure_id': id}">
                            <list>
                                <field name="question_id"/>
                                <field name="question_text"/>
                                <field name="measure_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Question Views -->
    <!-- List View -->
    <record id="referential_question_view_list" model="ir.ui.view">
        <field name="name">digiit.ebios_rm.referential.question.list</field>
        <field name="model">digiit.ebios_rm.referential.question</field>
        <field name="arch" type="xml">
            <list>
                <field name="referential_id" optional="show"/>
                <field name="chapter_code" string="Chapitre" optional="show"/>
                <field name="measure_code" string="Mesure"/>
                <field name="question_id" optional="hide"/>
                <field name="question_text"/>
                <field name="system_domain_ids" widget="many2many_tags" optional="show"/>
                <field name="plan_action" placeholder="Plan d'action..." optional="hide"/>
                <field name="bonne_pratique" placeholder="Bonne pratique..." optional="hide"/>
                <field name="vulnerabilite" placeholder="Vulnérabilité..." optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="referential_question_view_form" model="ir.ui.view">
        <field name="name">digiit.ebios_rm.referential.question.form</field>
        <field name="model">digiit.ebios_rm.referential.question</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="referential_id"/>
                            <field name="chapter_id"/>
                            <field name="measure_id"/>
                            <field name="system_domain_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="question_id"/>
                            <field name="question_text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Détails de la question">
                            <group>
                                <field name="plan_action" placeholder="Plan d'action..."/>
                                <field name="bonne_pratique" placeholder="Bonne pratique..."/>
                                <field name="vulnerabilite" placeholder="Vulnérabilité..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="referential_question_view_search" model="ir.ui.view">
        <field name="name">digiit.ebios_rm.referential.question.search</field>
        <field name="model">digiit.ebios_rm.referential.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="question_id" string="Question ID"/>
                <field name="question_text" string="Texte"/>
                <field name="referential_id" string="Référentiel"/>
                <field name="chapter_id" string="Chapitre"/>
                <field name="measure_id" string="Mesure"/>
                <field name="system_domain_ids" string="Domaines de sécurité"/>

                <separator/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_by_referential" string="Référentiel"
                            context="{'group_by': 'referential_id'}"/>
                    <filter name="group_by_chapter" string="Chapitre"
                            context="{'group_by': 'chapter_id'}"/>
                    <filter name="group_by_measure" string="Mesure"
                            context="{'group_by': 'measure_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_referential_list_view" model="ir.actions.act_window">
        <field name="name">Référentiels</field>
        <field name="res_model">digiit.ebios_rm.referential</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_questions_list_view" model="ir.actions.act_window">
        <field name="name">Questions des Référentiels</field>
        <field name="res_model">digiit.ebios_rm.referential.question</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_security_domain_list_view" model="ir.actions.act_window">
        <field name="name">Domaines de Sécurité</field>
        <field name="res_model">digiit.ebios_rm.system.domain</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="referential_menu_item"
        name="Référentiels"
        parent="referential"
        sequence="10"
        action="action_referential_list_view"
    />

    <menuitem
        id="referentiel_questions_menu_item"
        name="Questions des Référentiels"
        parent="referential"
        sequence="20"
        action="action_questions_list_view"
    />

    <menuitem
        id="security_domain_menu_item"
        name="Domaines de Sécurité"
        parent="referential"
        sequence="30"
        action="action_security_domain_list_view"
    />

</odoo>