
<odoo>
    <record id="scale_impact_level_view_list" model="ir.ui.view">
        <field name="name">Scale Impact Level list</field>
        <field name="model">digiit.ebios_rm.scale.impact.level</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom">
                <field name="num" string="Niveau"/>
                <field name="color" string="Couleur" widget="color"/>
            </list>
        </field>  
    </record>
    <record id="scale_impact_level_view_form" model="ir.ui.view">
        <field name="name">scale_impact_level Form</field>
        <field name="model">digiit.ebios_rm.scale.impact.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="num" string="Niveau"/>
                        <field name="color" string="Couleur" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_scale_impact_level_list_view" model="ir.actions.act_window">
        <field name="name">Scale Impact Levels</field>
        <field name="res_model">digiit.ebios_rm.scale.impact.level</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="scale_impact_level_view_list"/>
    </record>

    <!-- <menuitem
        id="impact_level_menu_item"
        name="Niveaux d'impacts"
        parent="échelles"
        action="action_scale_impact_level_list_view"
        /> -->

    
</odoo>