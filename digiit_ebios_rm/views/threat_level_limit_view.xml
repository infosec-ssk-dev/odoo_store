
<odoo>
    <record id="threat_level_limit_view_list" model="ir.ui.view">
        <field name="name">digiit.ebios_rm.threat.level.limit list</field>
        <field name="model">digiit.ebios_rm.threat.level.limit</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="Nom"/>
                <field name="value" string="Valeur"/>
                <field name="held" string="Retenu?"/>
                <field name="color" string="Couleur" widget="color"/>
                <field name="is_minimal" string="Minimale?"/>
                <field name="is_maximal" string="Maximale?"/>
            </list>
        </field>  
    </record>
    <record id="threat_level_limit_view_form" model="ir.ui.view">
        <field name="name">digiit.ebios_rm.threat.level.limit Form</field>
        <field name="model">digiit.ebios_rm.threat.level.limit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nom"/>
                        <field name="value" string="Valeur"/>
                        <field name="held" string="Retenu?"/>
                        <field name="color" string="Couleur" widget="color"/>
                        <field name="is_minimal" string="Minimale?"/>
                        <field name="is_maximal" string="Maximale?"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_threat_level_limit_list_view" model="ir.actions.act_window">
        <field name="name">Gestion des niveaux de menace</field>
        <field name="res_model">digiit.ebios_rm.threat.level.limit</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="threat_level_limit_view_list"/>
    </record>

    
    <menuitem
        id="threat_level_limit_menu_item"
        name="Limites des niveaux de menaces"
        parent="main_menu"
        sequence="15"
        action="action_threat_level_limit_list_view"
        />
</odoo>