
<odoo>
    <record id="likelihood_value_view_list" model="ir.ui.view">
        <field name="name">Likelihood Value list</field>
        <field name="model">digiit.ebios_rm.likelihood.value</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="Vraisemblance"/>
            </list>
        </field>  
    </record>
    <record id="likelihood_value_view_form" model="ir.ui.view">
        <field name="name">likelihood_value Form</field>
        <field name="model">digiit.ebios_rm.likelihood.value</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Vraisemblance"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_likelihood_value_list_view" model="ir.actions.act_window">
        <field name="name">Vraisemblance</field>
        <field name="res_model">digiit.ebios_rm.likelihood.value</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="likelihood_value_view_list"/>
    </record>

    
    <!-- <menuitem
        id="likelihood_value_menu_item"
        name="Vraisemblance"
        parent="main_menu"
        action="action_likelihood_value_list_view"
        /> -->
</odoo>