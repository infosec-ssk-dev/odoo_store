
<odoo>
    <record id="abstract_simple_scale_view_list" model="ir.ui.view">
        <field name="name">Abstract Simple Scale list</field>
        <field name="model">digiit.ebios_rm.abstract.simple.scale</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="description" string="Description"/>
            </list>
        </field>  
    </record>
    <record id="abstract_simple_scale_view_form" model="ir.ui.view">
        <field name="name">abstract_simple_scale Form</field>
        <field name="model">digiit.ebios_rm.abstract.simple.scale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="description" string="Description"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_abstract_simple_scale_list_view" model="ir.actions.act_window">
        <field name="name">Abstract Simple Scales</field>
        <field name="res_model">digiit.ebios_rm.abstract.simple.scale</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="abstract_simple_scale_view_list"/>
    </record>

</odoo>