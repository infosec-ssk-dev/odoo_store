
<odoo>
    <record id="scale_risk_details_view_list" model="ir.ui.view">
        <field name="name">Scale Risk Details list</field>
        <field name="model">digiit.ebios_rm.scale.risk.details</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="num" string="Nombre"/>
            </list>
        </field>  
    </record>
    <record id="scale_risk_details_view_form" model="ir.ui.view">
        <field name="name">scale_risk_details Form</field>
        <field name="model">digiit.ebios_rm.scale.risk.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="num" string="Nombre"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_scale_risk_details_list_view" model="ir.actions.act_window">
        <field name="name">Scale Risk Details</field>
        <field name="res_model">digiit.ebios_rm.scale.risk.details</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="scale_risk_details_view_list"/>
    </record>

    
