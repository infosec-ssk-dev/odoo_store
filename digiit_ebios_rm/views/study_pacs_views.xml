<odoo>
    <!-- List View for PACS -->
    <record id="study_pacs_view_list" model="ir.ui.view">
        <field name="name">Liste PACS</field>
        <field name="model">digiit.ebios_rm.study.pacs</field>
        <field name="arch" type="xml">
            <list string="PACS" editable="bottom">
                <field name="referential_name" optional="show"/>
                <field name="referential_version" optional="show"/>
                <field name="measure_display" optional="show"/>
                <field name="measure_number" optional="hide"/>
                <field name="measure_title" optional="hide"/>
                <field name="system_domain_ids" widget="many2many_tags" optional="show"/>
                <field name="risk_treatment_ids" optional="show" widget="many2many_tags"/>
                <field name="ecosystem_ids" optional="show" widget="many2many_tags"/>
                <field name="security_baseline_applicable" optional="show"/>
                <field name="freins" optional="show"/>
                <field name="cout" optional="show"/>
                <field name="echeance" optional="show"/>
                <field name="application_status_id" optional="show"/>
                <field name="status_name" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View for PACS -->
    <record id="study_pacs_view_form" model="ir.ui.view">
        <field name="name">Formulaire PACS</field>
        <field name="model">digiit.ebios_rm.study.pacs</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_risk_treatments"
                                icon="fa-exclamation-triangle">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Risques</span>
                                <span class="o_stat_value">
                                    <field name="risk_treatment_count"/>
                                </span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="referential_name" readonly="1" class="oe_inline"/>
                            <span class="oe_inline"> - </span>
                            <field name="referential_version" readonly="1" class="oe_inline"/>
                        </h1>
                        <h2>
                            <field name="measure_display" readonly="1"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Informations de la mesure">
                            <field name="study_id" invisible="1"/>
                            <field name="study_measure_id" options="{'no_create': True}"/>
                            <field name="system_domain_ids" widget="many2many_tags"/>
                            <field name="risk_treatment_ids" readonly="1"/>
                            <field name="measure_contenu" readonly="1"/>
                        </group>

                        <group string="Planification">
                            <field name="echeance"/>
                            <field name="cout"/>
                            <field name="application_status_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Plan d'action">
                            <group>
                                <field name="plan_action" placeholder="Décrivez les étapes de mise en œuvre..." nolabel="1"/>
                            </group>
                        </page>

                        <page string="Freins">
                            <group>
                                <field name="freins" placeholder="Identifiez les obstacles potentiels..." nolabel="1"/>
                            </group>
                        </page>

                        <page string="Risques associés">
                            <field name="risk_treatment_ids" readonly="1">
                                <list>
                                    <field name="identifier"/>
                                    <field name="attack_path_text"/>
                                    <field name="severity"/>
                                    <field name="likelihood"/>
                                    <field name="risk_level"/>
                                </list>
                            </field>
                            <field name="ecosystem_ids" readonly="1"/>
                            <field name="security_baseline_applicable" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="study_pacs_view_search" model="ir.ui.view">
    <field name="name">digiit.ebios_rm.study.pacs.search</field>
    <field name="model">digiit.ebios_rm.study.pacs</field>
    <field name="arch" type="xml">
        <search string="PACS">
            <field name="measure_display"/>
            <field name="referential_name"/>
            <field name="risk_treatment_ids"/>

            <!-- group by -->
            <group expand="0" string="Regrouper par">
                <filter name="grp_ref" string="Référentiel" context="{'group_by':'referential_name'}"/>
                <filter name="grp_domain" string="Domaine de sécurité" context="{'group_by':'system_domain_ids'}"/>
                <filter name="grp_risk_treatment_ids" string="Scénarios de risques associés" context="{'group_by':'risk_treatment_ids'}"/>
                <filter name="grp_status" string="Statut" context="{'group_by':'application_status_id'}"/>
            </group>
        </search>
    </field>
</record>


    <!-- Action for PACS -->
    <record id="action_study_pacs_list_view" model="ir.actions.act_window">
        <field name="name">Plan d'amélioration continue de la sécurité</field>
        <field name="res_model">digiit.ebios_rm.study.pacs</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="view_id" ref="study_pacs_view_list"/>
        <field name="domain">[('study_id', '=', active_id)]</field>
        <field name="context">{'default_study_id': active_id}</field>
    </record>
</odoo>