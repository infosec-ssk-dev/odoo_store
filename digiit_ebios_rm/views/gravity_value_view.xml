
<odoo>
    <record id="gravity_value_view_list" model="ir.ui.view">
        <field name="name">Gravity Value list</field>
        <field name="model">digiit.ebios_rm.gravity.value</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="Gravité"/>
            </list>
        </field>  
    </record>
    <record id="gravity_value_view_form" model="ir.ui.view">
        <field name="name">gravity_value Form</field>
        <field name="model">digiit.ebios_rm.gravity.value</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Gravité"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_gravity_value_list_view" model="ir.actions.act_window">
        <field name="name">Valeurs de gravité</field>
        <field name="res_model">digiit.ebios_rm.gravity.value</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="gravity_value_view_list"/>
    </record>

    
    <!-- <menuitem
        id="gravity_value_menu_item"
        name="Gravité"
        parent="main_menu"
        action="action_gravity_value_list_view"
        /> -->
</odoo>