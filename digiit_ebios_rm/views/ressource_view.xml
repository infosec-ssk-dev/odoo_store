
<odoo>
    <record id="ressource_view_list" model="ir.ui.view">
        <field name="name">Ressource list</field>
        <field name="model">digiit.ebios_rm.ressource</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom">
                <field name="number" string="Niveau"/>
                <field name="name" string="Nom"/>
                <field name="color" widget="color"/>
            </list>
        </field>  
    </record>
    <record id="ressource_view_form" model="ir.ui.view">
        <field name="name">ressource Form</field>
        <field name="model">digiit.ebios_rm.ressource</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="number" string="Niveau"/>
                        <field name="name" string="Nom"/>
                        <field name="color" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_ressource_list_view" model="ir.actions.act_window">
        <field name="name">Ressources</field>
        <field name="res_model">digiit.ebios_rm.ressource</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="ressource_view_list"/>
    </record>

    
    <menuitem
        id="ressource_menu_item"
        name="Ressources"
        parent="pertinence_src_risk"
        action="action_ressource_list_view"
        sequence="20"
        />
</odoo>