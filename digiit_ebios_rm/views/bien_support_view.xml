<odoo>
    <record id="bien_support_view_list" model="ir.ui.view">
        <field name="name">Bien Support list</field>
        <field name="model">digiit.ebios_rm.bien.support</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom">
                <field name="name" string="Nom du bien"/>
                <field name="classification" string="Classification"/>
                <field name="description" string="Description"/>
                <field name="personne_proprietaire" string="Entité/ Personne Propriétaire"/>
            </list>
        </field>
    </record>

    <record id="bien_support_view_form" model="ir.ui.view">
        <field name="name">bien_support Form</field>
        <field name="model">digiit.ebios_rm.bien.support</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nom du bien"/>
                        <field name="classification" string="Classification"/>
                        <field name="description" string="Description"/>
                        <field name="personne_proprietaire" string="Entité/ Personne Propriétaire"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bien_support_list_view" model="ir.actions.act_window">
        <field name="name">Bien Support</field>
        <field name="res_model">digiit.ebios_rm.bien.support</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="bien_support_view_list"/>
    </record>

    <!-- Uncomment if you want a menu item for it -->
    <!-- <menuitem
        id="bien_support_menu_item"
        name="Bien Support"
        parent="main_menu"
        action="action_bien_support_list_view"
    /> -->
</odoo>