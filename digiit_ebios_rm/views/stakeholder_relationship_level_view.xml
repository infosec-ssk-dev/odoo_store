
<odoo>
    <record id="stakeholder_relationship_level_view_list" model="ir.ui.view">
        <field name="name">Stakeholder Relationship Level list</field>
        <field name="model">digiit.ebios_rm.stakeholder.relationship.level</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="name" string="Nombre"/>
                <field name="pivot" string="Risque"/>
            </list>
        </field>  
    </record>
    <record id="stakeholder_relationship_level_view_form" model="ir.ui.view">
        <field name="name">stakeholder_relationship_level Form</field>
        <field name="model">digiit.ebios_rm.stakeholder.relationship.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nombre"/>
                        <field name="pivot" string="Risque" />
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_stakeholder_relationship_level_list_view" model="ir.actions.act_window">
        <field name="name">Stakeholder Relationship Levels</field>
        <field name="res_model">digiit.ebios_rm.stakeholder.relationship.level</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="stakeholder_relationship_level_view_list"/>
    </record>

    <!-- <menuitem
        id="scale_risk_level_menu_item"
        name="Stakeholder relationships"
        parent="main_menu"
        action="action_scale_risk_level_list_view"
        /> -->

    
</odoo>