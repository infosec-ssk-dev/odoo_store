
<odoo>
    <record id="digiit_has_color_view_list" model="ir.ui.view">
        <field name="name">Digiit Has Color list</field>
        <field name="model">digiit.ebios_rm.has.color</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="color" widget="color"/>
            </list>
        </field>  
    </record>
    <record id="digiit_has_color_view_form" model="ir.ui.view">
        <field name="name">digiit_has_color Form</field>
        <field name="model">digiit.ebios_rm.has.color</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="color" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_digiit_has_color_list_view" model="ir.actions.act_window">
        <field name="name">Digiit Has Colors</field>
        <field name="res_model">digiit.ebios_rm.has.color</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="digiit_has_color_view_list"/>
    </record>

</odoo>