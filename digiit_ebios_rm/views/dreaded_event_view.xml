
<odoo>
    <record id="dreaded_event_view_list" model="ir.ui.view">
        <field name="name">Dreaded Event list</field>
        <field name="model">digiit.ebios_rm.dreaded.event</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom" decoration-success="held" decoration-danger="not held">
                <field name="prefixed_identifier" string="Identifier" optional="show"/>
                <field name="business_value_id" string="VM" options="{'no_create': True}" optional="show"/>
                <field name="title" string="Événement redouté intitulé" optional="show"/>
                <field name="impacted_security_criteria" string="Critères de sécurité impactés"  widget="many2many_tags" options="{'no_create': True}" optional="show"/>
                <field name="brand_image_impact" string="Imp. sur l'image de marque" optional="show" class="o_centered_column"/>
                <field name="financial_impact" string="Imp. financier" optional="show" class="o_centered_column"/>
                <field name="legal_impact" string="Imp. juridique" optional="show" class="o_centered_column"/>
                <field name="operational_impact" string="Imp. opérationnel" optional="show" class="o_centered_column"/>
                <field name="impact_justification" string="Justification des impacts" optional="show"/>
                <field name="gross_gravity" string="Gravité Brute" optional="show" class="o_centered_column"/>
                <field name="existant_safety_measures" optional="show"/>
                <field name="actual_gravity" string="Gravité actuelle" optional="show" class="o_centered_column"/>
                <field name="held" string="Retenu?" optional="show"/>
            </list>
        </field>
    </record>
    <record id="dreaded_event_view_form" model="ir.ui.view">
        <field name="name">dreaded_event Form</field>
        <field name="model">digiit.ebios_rm.dreaded.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="prefixed_identifier" string="Identifier"/>
                        <field name="title" string="Événement redouté intitulé"/>
                        <field name="impacted_security_criteria" string="Critères de sécurité impactés"  widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="brand_image_impact" string="Imp. sur l'image de marque"/>
                        <field name="financial_impact" string="Imp. financier"/>
                        <field name="legal_impact" string="Imp. juridique"/>
                        <field name="operational_impact" string="Imp. opérationnel"/>
                        <field name="impact_justification" string="Justification des impacts"/>
                        <field name="gross_gravity" string="Gravité Brute"/>
                        <field name="existant_safety_measures"/>
                        <field name="actual_gravity" string="Gravité actuelle"/>
                        <field name="held" string="Retenu?"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dreaded_event_search_view" model="ir.ui.view">
        <field name="name">dreaded_event Search</field>
        <field name="model">digiit.ebios_rm.dreaded.event</field>
        <field name="arch" type="xml">
            <search>
                <!-- Searchable -->
                <field name="prefixed_identifier" string="Identifier"/>
                <field name="title" string="Événement redouté intitulé"/>

                <!-- Filters -->
                <!-- Held -->
                <filter name="held_true" string="Retenus" domain="[('held', '=', True)]"/>
                <filter name="held_false" string="Non retenus" domain="[('held', '=', False)]"/>

                <!-- Business Value -->
                <filter name="by_business_value" string="Avec Valeur Métier"
                        domain="[('business_value_id', '!=', False)]"/>
                <filter name="by_business_value_none" string="Sans Valeur Métier"
                        domain="[('business_value_id', '=', False)]"/>

                <!-- study specific filter -->
                <filter string="Étude en cours" name="study_id"
                        domain="[('study_id', '=', context.get('default_study_id'))]"
                        invisible="1"/>

                <separator/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_by_business_value" string="Valeur Métier"
                            context="{'group_by':'business_value_id'}"/>
                    <filter name="group_by_held" string="Retenu ou non"
                            context="{'group_by':'held'}"/>
                        <filter string="Nombre de Sc. Stratégiques" name="group_strategic_scenario_count"
                            context="{'group_by':'strategic_scenario_count'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dreaded_event_list_view" model="ir.actions.act_window">
        <field name="name">Événements Redoutés</field>
        <field name="res_model">digiit.ebios_rm.dreaded.event</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="view_id" ref="dreaded_event_view_list"/>
        <field name="domain">[('study_id', '=', active_id)]</field>
        <field name="context">{'default_study_id': active_id}</field>
    </record>


    <!-- <menuitem
        id="dreaded_event_menu_item"
        name="Evénements redoutés"
        parent="main_menu"
        action="action_dreaded_event_list_view"
        /> -->
</odoo>