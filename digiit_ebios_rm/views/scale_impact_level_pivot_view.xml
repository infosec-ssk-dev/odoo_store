
<odoo>
    <record id="scale_impact_level_pivot_view_list" model="ir.ui.view">
        <field name="name">Scale Impact Level Pivot list</field>
        <field name="model">digiit.ebios_rm.scale.impact.level.pivot</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom" create="false">
                <field name="scale_impact_level_id" string="Echelle d'impact" readonly="1"/>
                <field name="scale_impact_id" string="Niveau d'impact" readonly="1"/>
                <field name="description" string="Description"/>
            </list>
        </field>  
    </record>
    <record id="scale_impact_level_pivot_view_form" model="ir.ui.view">
        <field name="name">scale_impact_level_pivot Form</field>
        <field name="model">digiit.ebios_rm.scale.impact.level.pivot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="description" string="Description"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_scale_impact_level_pivot_list_view" model="ir.actions.act_window">
        <field name="name">Scale Impact Level Pivots</field>
        <field name="res_model">digiit.ebios_rm.scale.impact.level.pivot</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="scale_impact_level_pivot_view_list"/>
    </record>

    <!-- <menuitem
        id="impact_level_pivot_menu_item"
