        <field name="name">Visual Operational Stage list</field>
        <field name="model">visual.operational.stage</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                
            </list>
        </field>  
    </record>
    <record id="visual_operational_stage_view_form" model="ir.ui.view">
