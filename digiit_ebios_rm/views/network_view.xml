
<odoo>
    <record id="network_view_list" model="ir.ui.view">
        <field name="name">Digiit Network list</field>
        <field name="model">digiit.ebios_rm.network</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="name" string=""/>
            </list>
        </field>  
    </record>
    <record id="network_view_form" model="ir.ui.view">
        <field name="name">network Form</field>
        <field name="model">digiit.ebios_rm.network</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string=""/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_network_list_view" model="ir.actions.act_window">
        <field name="name">Digiit Networks</field>
        <field name="res_model">digiit.ebios_rm.network</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="network_view_list"/>
    </record>

    
