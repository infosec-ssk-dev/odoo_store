
<odoo>
    <record id="activity_view_list" model="ir.ui.view">
        <field name="name">Activity list</field>
        <field name="model">digiit.ebios_rm.activity</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom">
                <field name="number" string="Niveau"/>
                <field name="name" string="Nom"/>
                <field name="color" widget="color"/>
            </list>
        </field>  
    </record>
    <record id="activity_view_form" model="ir.ui.view">
        <field name="name">Activity Form</field>
        <field name="model">digiit.ebios_rm.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="number" string="Niveau"/>
                        <field name="name" string="Nom"/>
                        <field name="color" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_activity_list_view" model="ir.actions.act_window">
        <field name="name">Activités</field>
        <field name="res_model">digiit.ebios_rm.activity</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="activity_view_list"/>
    </record>

    
    <menuitem
        id="activity_menu_item"
        name="Activités"
        parent="pertinence_src_risk"
        action="action_activity_list_view"
        sequence="30"
        />
</odoo>