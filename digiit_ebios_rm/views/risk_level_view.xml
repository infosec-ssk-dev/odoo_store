
<odoo>
    <record id="risk_level_view_list" model="ir.ui.view">
        <field name="name">Risk Level list</field>
        <field name="model">digiit.ebios_rm.risk.level</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="Niveau de risque"/>
            </list>
        </field>  
    </record>
    <record id="risk_level_view_form" model="ir.ui.view">
        <field name="name">risk_level Form</field>
        <field name="model">digiit.ebios_rm.risk.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Niveau de risque"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_risk_level_list_view" model="ir.actions.act_window">
        <field name="name">Risk Levels</field>
        <field name="res_model">digiit.ebios_rm.risk.level</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="risk_level_view_list"/>
    </record>

    
    <!-- <menuitem
        id="risk_level_menu_item"
        name="Niveaux de risques"
        parent="main_menu"
        action="action_risk_level_list_view"
        /> -->
</odoo>