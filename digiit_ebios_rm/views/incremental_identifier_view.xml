
<odoo>
    <record id="incremental_identifier_view_list" model="ir.ui.view">
        <field name="name">Incremental Identifier list</field>
        <field name="model">digiit.ebios_rm.incremental.identifier</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="identifier" string="Identifier"/>
            </list>
        </field>  
    </record>
    <record id="incremental_identifier_view_form" model="ir.ui.view">
        <field name="name">incremental_identifier Form</field>
        <field name="model">digiit.ebios_rm.incremental.identifier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="identifier" string="Identifier"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_incremental_identifier_list_view" model="ir.actions.act_window">
        <field name="name">Incremental Identifiers</field>
        <field name="res_model">digiit.ebios_rm.incremental.identifier</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="incremental_identifier_view_list"/>
    </record>
</odoo>