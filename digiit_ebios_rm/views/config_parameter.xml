<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.digiit_ebios_rm</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Paramètres géneraux" string="Paramètres géneraux" name="digiit_ebios_rm" >
                        <t>
                            <block title="Paramètres des risques" name="risk_prams_setting_container" data-key="digiit_ebios_rm">
                                <setting string="Paramètres des valeurs limites" company_dependent="1" id="digiit_ebios_rm.maximum_accepted_risk" >
                                    <div class="content-group">
                                        <div class="mt16">
                                            <div>
                                                <label for="accepted_risk_level" string="Niveau de risque accepté (gravité des evénements redoutés)" class="col-2 o_light_label"/>
                                                <field name="accepted_risk_level"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="content-group">
                                        <div class="mt16">
                                            <div>
                                                <label for="accepted_risk_level_sc_strategic" string="Niveau de gravité accepté ( scenarios strategiques )" class="col-2 o_light_label"/>
                                                <field name="accepted_risk_level_sc_strategic"/>
                                            </div>
                                        </div>
                                    </div>
                                </setting>
                            </block>
                        </t>
                    </app>
                </xpath>
            </field>
        </record>

        <!-- <record id="action_diggit_ebios_config" model="ir.actions.act_window">
            <field name="name">My Module Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="context">{'module' : 'diggit_ebios'}</field>
        </record> -->

        <record id="action_general_configuration_values_view" model="ir.actions.act_window">
            <field name="name">General Configurations</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="res_config_settings_view_form"/>
            <field name="target">inline</field>
            <field name="context">{'module' : 'digiit_ebios_rm'}</field>
            <field name="view_id" ref="digiit_ebios_rm.res_config_settings_view_form"/>
        </record>

        <menuitem
        id="general_configuration_menu_item"
        name="Configurations Génerales"
        parent="main_menu"
        sequence="5"
        action="action_general_configuration_values_view"
        />
    </data>
</odoo>