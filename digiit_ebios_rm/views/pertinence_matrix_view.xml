
<odoo>
    <record id="pertinence_matrix_view_list" model="ir.ui.view">
        <field name="name">Pertinence Matrix list</field>
        <field name="model">digiit.ebios_rm.pertinence.matrix</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false">
                <field name="motivation_id" string="Motivation" />
                <field name="ressource_id" string="Ressource"/>
                <field name="pertinence_id" string="Pertinence"/>
            </list>
        </field>  
    </record>
    <record id="pertinence_matrix_view_form" model="ir.ui.view">
        <field name="name">pertinence_matrix Form</field>
        <field name="model">digiit.ebios_rm.pertinence.matrix</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="motivation_id" />
                        <field name="ressource_id" />
                        <field name="pertinence_id" />
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_pertinence_matrix_list_view" model="ir.actions.act_window">
        <field name="name">Pertinence des sources de risques</field>
        <field name="res_model">digiit.ebios_rm.pertinence.matrix</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="pertinence_matrix_view_list"/>
    </record>

    
    <menuitem
        id="pertinence_matrix_menu_item"
        name="Pertinence des sources de risques"
        parent="pertinence_src_risk"
        action="action_pertinence_matrix_list_view"
        sequence="50"
        />
</odoo>