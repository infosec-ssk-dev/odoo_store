
<odoo>
    <record id="risk_level_matrix_view_list" model="ir.ui.view">
        <field name="name">Risk Level Matrix list</field>
        <field name="model">digiit.ebios_rm.risk.level.matrix</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false">
                <field name="gravity" string="Gravité" readonly="1"/>
                <field name="likelihood" string="Vraisemblance" readonly="1"/>
                <field name="risk_level" string="Niveau de risque"/>
            </list>
        </field>  
    </record>

    <record id="action_risk_level_matrix_list_view" model="ir.actions.act_window">
        <field name="name">Matrice de guide ANSSI</field>
        <field name="res_model">digiit.ebios_rm.risk.level.matrix</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="risk_level_matrix_view_list"/>
    </record>

    
    <menuitem
        id="risk_level_matrix_menu_item"
        name="Matrice de guide ANSSI"
        parent="main_menu"
        action="action_risk_level_matrix_list_view"
        />
</odoo>