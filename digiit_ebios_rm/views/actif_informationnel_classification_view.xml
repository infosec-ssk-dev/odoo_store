
<odoo>
    <record id="actif_informationnel_classification_view_list" model="ir.ui.view">
        <field name="name">Actif Informationnel Classification list</field>
        <field name="model">digiit.ebios_rm.actif.informationnel.classification</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom">
                <field name="name" string="Nom"/>
            </list>
        </field>  
    </record>
    <record id="actif_informationnel_classification_view_form" model="ir.ui.view">
        <field name="name">actif_informationnel_classification Form</field>
        <field name="model">digiit.ebios_rm.actif.informationnel.classification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nom"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_actif_informationnel_classification_list_view" model="ir.actions.act_window">
        <field name="name">Classifications des actifs informationnels</field>
        <field name="res_model">digiit.ebios_rm.actif.informationnel.classification</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="actif_informationnel_classification_view_list"/>
    </record>

    
    <menuitem
        id="actif_informationnel_classification_menu_item"
        name="Classifications des actifs informationnels"
        parent="main_menu"
        action="action_actif_informationnel_classification_list_view"
        />
</odoo>