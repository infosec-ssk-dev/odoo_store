
<odoo>
    <record id="scale_likelihood_view_list" model="ir.ui.view">
        <field name="name">Scale Likelihood list</field>
        <field name="model">digiit.ebios_rm.scale.likelihood</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="description" string="Description"/>
            </list>
        </field>  
    </record>
    <record id="scale_likelihood_view_form" model="ir.ui.view">
        <field name="name">scale_likelihood Form</field>
        <field name="model">digiit.ebios_rm.scale.likelihood</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="description" string="Description"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_scale_likelihood_list_view" model="ir.actions.act_window">
        <field name="name">Scale Likelihoods</field>
        <field name="res_model">digiit.ebios_rm.scale.likelihood</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="scale_likelihood_view_list"/>
    </record>

    
    <!-- <menuitem
        id="scale_likelihood_menu_item"
        name="Echelle de vraisemblance"
        parent="échelles"
        action="action_scale_likelihood_list_view"
        /> -->
</odoo>