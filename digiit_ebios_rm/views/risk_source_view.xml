
<odoo>
    <record id="risk_source_view_list" model="ir.ui.view">
        <field name="name">Risk Source list</field>
        <field name="model">digiit.ebios_rm.risk.source</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom" decoration-success="held" decoration-danger="not held">
                <field name="prefixed_identifier" string="Identifier" readonly="1" optional="show"/>
                <field name="source_of_risk_id" string="Source de risque" options="{'no_create': True}" optional="show"/>
                <field name="targeted_objectif_id" string="Objectifs visés" options="{'no_create': True}" optional="show"/>
                <field name="source_of_risk_name" string="Source de risque" optional="hide"/>
                <field name="targeted_objectif_name" string="Objectifs visés" optional="hide"/>
                <field name="motivation_id" string="Motivations" optional="show"/>
                <field name="ressource_id" string="Ressources" optional="show"/>
                <field name="activity_id" string="Activités" optional="show"/>
                <field name="pertinence_id" string="Pertinence Proposée" optional="show"/>
                <field name="pertinence_retenue_id" string="Pertinence Retenue" optional="show"/>
                <field name="held" string="Retenu" optional="show"/>
                <field name="dreaded_event_ids" widget="many2many_tags" string="Evénements redoutés associés" options="{'no_create': True}" optional="show"/>
                <field name="justification" string="Justification" optional="show"/>
                <field name="description" string="Description" optional="show"/>
            </list>
        </field> 
    </record>
    <record id="risk_source_view_form" model="ir.ui.view">
        <field name="name">risk_source Form</field>
        <field name="model">digiit.ebios_rm.risk.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="identifier" string="Identifier"/>
                        </group>
                        <notebook>
                            <page string="Informations générales">
                                <field name="source_of_risk_name" string="Source de risque" invisible="1"/>
                                <field name="targeted_objectif_name" string="Objectifs visés" invisible="1"/>
                                <group>
                                    <field name="source_of_risk_id" string="Source de risque"/>
                                </group>
                                <group>
                                    <field name="targeted_objectif_id" string="Objectifs visés"/>
                                </group>
                                <group>
                                    <field name="motivation_id" string="Motivations"/>
                                </group>
                                <group>
                                    <field name="ressource_id" string="Ressources"/>
                                </group>
                                <group>
                                    <field name="activity_id" string="Activités"/>
                                </group>
                                <group>
                                    <field name="pertinence_id" string="Pertinence Proposée" optional="show"/>
                                    <field name="pertinence_retenue_id" string="Pertinence Retenue" optional="show"/>
                                </group>
                                <group>
                                    <field name="held" string="Retenu"/>
                                </group>
                            </page>
                            <page string="Parties prenantes">
                                <field name="dreaded_event_ids" string="Evénements redoutés associés" options="{'no_create': True}"/>
                            </page>
                        </notebook>
                    </group>
                    
                    <!-- <field name="targeted_objectif" string="Objectif visé"/>
                    <field name="source_of_risk" string="Source de risque"/> -->
                    <field name="dreaded_event_ids" string="Evénements redoutés associés" widget="many2many_tags"/>
                    <field name="justification" string="Justification" optional="show"/>
                    <field name="description" string="Description" optional="show"/>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="risk_source_search_view" model="ir.ui.view">
        <field name="name">Risk Source Search</field>
        <field name="model">digiit.ebios_rm.risk.source</field>
        <field name="arch" type="xml">
            <search>
                <!-- Searchable fields -->
                <field name="prefixed_identifier" string="Identifier"/>
                <field name="source_of_risk_id" string="Source de risque"/>
                <field name="targeted_objectif_id" string="Objectifs visés"/>

                <!-- Boolean Filters -->
                <filter name="held_true" string="Retenues" domain="[('held', '=', True)]"/>
                <filter name="held_false" string="Non retenues" domain="[('held', '=', False)]"/>

                <!-- Dreaded Event -->
                <filter name="has_dreaded_events" string="Avec Événements redoutés"
                        domain="[('dreaded_event_ids', '!=', False)]"/>
                <filter name="no_dreaded_events" string="Sans Événements redoutés"
                        domain="[('dreaded_event_ids', '=', False)]"/>

                <!-- Hidden study filter (used by action domain but invisible in UI) -->
                <filter name="study_filter" string="Étude en cours"
                        domain="[('study_id', '=', context.get('default_study_id'))]"
                        invisible="1"/>
                <separator/>

                <!-- GROUP BY -->
                <group expand="0" string="Group By">
                    <filter name="group_by_source" string="Source de risque"
                            context="{'group_by':'source_of_risk_id'}"/>
                    <filter name="group_by_target" string="Objectif visé"
                            context="{'group_by':'targeted_objectif_id'}"/>
                    <filter string="Nombre de Sc. Stratégiques" name="group_strategic_scenario_count"
                            context="{'group_by':'strategic_scenario_count'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_risk_source_list_view" model="ir.actions.act_window">
        <field name="name">Sources de Risque</field>
        <field name="res_model">digiit.ebios_rm.risk.source</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="view_id" ref="risk_source_view_list"/>
        <field name="domain">[('study_id', '=', active_id)]</field>
        <field name="context">{'default_study_id': active_id}</field>
    </record>

    
    <!-- <menuitem
        id="risk_source_menu_item"
        name="Sources de risque"
        parent="main_menu"
        action="action_risk_source_list_view"
        /> -->
</odoo>