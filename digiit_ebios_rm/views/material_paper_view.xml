
<odoo>
    <record id="material_paper_view_list" model="ir.ui.view">
        <field name="name">Digiit Material Paper list</field>
        <field name="model">digiit.ebios_rm.material.paper</field>
        <field name="arch" type="xml">
            <list class="list-custom">
                <field name="name" string=""/>
            </list>
        </field>  
    </record>
    <record id="material_paper_view_form" model="ir.ui.view">
        <field name="name">material_paper Form</field>
        <field name="model">digiit.ebios_rm.material.paper</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string=""/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_material_paper_list_view" model="ir.actions.act_window">
        <field name="name">Digiit Material Papers</field>
        <field name="res_model">digiit.ebios_rm.material.paper</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="material_paper_view_list"/>
    </record>

    
    <!-- <menuitem
        id="material_paper_menu_item"
        name="Matériels / Papiers"
        parent="main_menu"
        action="action_material_paper_list_view"
        /> -->
</odoo>