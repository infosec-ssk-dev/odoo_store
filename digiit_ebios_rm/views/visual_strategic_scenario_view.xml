<odoo>

    <record id="action_risk_dashboard" model="ir.actions.client">
        <field name="name">Les scénarios strtégiques</field>
        <field name="tag">risk_dashboard.dashboard</field>
        <field name="target">current</field>
    </record>


    <record id="visual_strategic_scenario_view_list" model="ir.ui.view">
        <field name="name">Liste des scénarios stratégiques visuels</field>
        <field name="model">digiit.ebios_rm.visual.strategic.scenario</field>
        <field name="arch" type="xml">
            <list editable="bottom" delete="False">
                <field name="risk_source_id" options="{'no_create': True}" optional="show"/>
                <field name="dreaded_event_id" options="{'no_create': True}" optional="show"/>
                <field name="stakeholder_ids" widget="many2many_tags" optional="show"/>
                <field name="actif_display" string="Cible" optional="show" readonly="1"/>
                <field name="seriousness" string="Gravité" optional="show" class="o_centered_column"/>
                <field name="justification" string="Justification de gravité" optional="show"/>
                <button name="action_delete_sc_st_with_confirmation"
                        type="object"
                        class="btn-outline-secondary"
                        icon="fa-trash" title="Supprimer l'enregistrement"
                        confirm="Êtes-vous sûr de vouloir supprimer ce scénario stratégique ? Cette action supprimera également et immédiatement tous les scénarios opérationnels associés (Atelier 4) et les traitements de risque correspondants (Atelier 5)!"/>
            </list>
        </field>
    </record>

    <record id="visual_strategic_scenario_search_view" model="ir.ui.view">
        <field name="name">Strategic Scenario Search</field>
        <field name="model">digiit.ebios_rm.visual.strategic.scenario</field>
        <field name="arch" type="xml">
            <search>
                <!-- Basic Search Fields -->
                <field name="risk_source_id" string="SR-OV"/>
                <field name="dreaded_event_id" string="Evénement redouté"/>
                <field name="stakeholder_ids" string="PiP"/>
                <!-- Filters -->
                <filter name="has_stakeholders" string="Avec PiP"
                        domain="[('stakeholder_ids','!=', False)]"/>
                <filter name="no_stakeholders" string="Sans PiP"
                        domain="[('stakeholder_ids','=', False)]"/>
                <!-- Hidden study filter (auto-applied by context) -->
                <filter name="study_filter" string="Étude en cours"
                        domain="[('study_id', '=', context.get('default_study_id'))]"
                        invisible="1"/>

                <separator/>

                <!-- GROUP BY -->
                <group expand="0" string="Group By">
                    <filter name="group_by_risk_src" string="SR-OV"
                            context="{'group_by':'risk_source_id'}"/>
                    <filter name="group_by_er" string="Evénement redouté"
                            context="{'group_by':'dreaded_event_id'}"/>
                    <filter name="group_by_pip" string="PiP"
                            context="{'group_by':'stakeholder_ids'}"/>
                    <filter name="group_by_severity" string="Gravité"
                            context="{'group_by':'seriousness'}"/>
                    <filter string="Nombre de Sc. Opérationnels" name="group_operational_scenario_count"
                            context="{'group_by':'operational_scenario_count'}"/>
                    <filter string="Nombre de Traitements" name="group_risk_treatment_count"
                            context="{'group_by':'risk_treatment_count'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_visual_strategic_scenario_list_view" model="ir.actions.act_window">
        <field name="name">Scénarios Stratégiques</field>
        <field name="res_model">digiit.ebios_rm.visual.strategic.scenario</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="view_id" ref="visual_strategic_scenario_view_list"/>
        <field name="domain">[('study_id', '=', active_id)]</field>
        <field name="context">{'default_study_id': active_id}</field>
    </record>

    <!-- Menu Item -->
    <menuitem 
        id="pip_config_menu_item"
        name="PiP"
        parent="sr_ov"
        action="action_stakeholder"
        sequence="30"/>

</odoo>