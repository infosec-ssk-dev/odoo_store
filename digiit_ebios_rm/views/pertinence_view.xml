
<odoo>
    <record id="pertinence_view_list" model="ir.ui.view">
        <field name="name">Pertinence list</field>
        <field name="model">digiit.ebios_rm.pertinence</field>
        <field name="arch" type="xml">
            <list class="list-custom" editable="bottom">
                <field name="number" string="Niveau"/>
                <field name="name" string="Nom"/>
                <field name="retenu" string="Retenu?"/>
                <field name="color" widget="color"/>
            </list>
        </field>  
    </record>
    <record id="pertinence_view_form" model="ir.ui.view">
        <field name="name">pertinence Form</field>
        <field name="model">digiit.ebios_rm.pertinence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="number" string="Niveau"/>
                        <field name="name" string="Nom"/>
                        <field name="retenu" string="Retenu?"/>
                        <field name="color" widget="color"/>
                    </group>
                    
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_pertinence_list_view" model="ir.actions.act_window">
        <field name="name">Pertinences</field>
        <field name="res_model">digiit.ebios_rm.pertinence</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="pertinence_view_list"/>
    </record>

    
    <menuitem
        id="pertinence_menu_item"
        name="Pertinences"
        parent="pertinence_src_risk"
        action="action_pertinence_list_view"
        sequence="40"
        />
</odoo>