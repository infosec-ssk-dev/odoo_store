
<odoo>
    <record id="stakeholder_relationtionship_threat_pivot_view_list" model="ir.ui.view">
        <field name="name">Liste pivot des menaces enelation avec les parties prenantes</field>
        <field name="model">digiit.ebios_rm.stakeholder.relationtionship.threat.pivot</field>
        <field name="arch" type="xml">
            <list class="list-custom" >
                <field name="description" string="Description"/>
                <field name="stakeholder_relationship_level_id" string=""/>
            </list>
        </field>  
    </record>
    <record id="stakeholder_relationtionship_threat_pivot_view_form" model="ir.ui.view">
        <field name="name">Formulaire menace en relation avec les parties prenantes</field>
        <field name="model">digiit.ebios_rm.stakeholder.relationtionship.threat.pivot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="description" string="Description"/>
                        <field name="stakeholder_relationship_level_id" string=""/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record>

    <record id="action_stakeholder_relationtionship_threat_pivot_list_view" model="ir.actions.act_window">
        <field name="name">Pivot des menaces en relation avec les parties prenantes</field>
        <field name="res_model">digiit.ebios_rm.stakeholder.relationtionship.threat.pivot</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="stakeholder_relationtionship_threat_pivot_view_list"/>
    </record>

</odoo>