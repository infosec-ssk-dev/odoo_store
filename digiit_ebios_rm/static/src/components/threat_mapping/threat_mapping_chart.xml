<templates xml:space="preserve">
    <t t-name="digiit_ebios_rm.EcosystemThreatMap" owl="1">
        <div class="o_threat_mapping_chart">
            <!-- Header Panel -->
            <div class="control-panel p-2 bg-light border-bottom d-flex align-items-center justify-content-between">
                <button class="btn btn-secondary" t-on-click="goBack">
                    <i class="fa fa-arrow-left me-1"></i>Retour
                </button>

                <span class="fw-bold fs-4">Cartographie de Menace des Parties Intéressées</span>

                <button class="btn btn-primary" t-on-click="captureAll"
                        t-att-disabled="state.isCapturing">
                    <i class="fa fa-camera me-1" t-if="!state.isCapturing"></i>
                    <i class="fa fa-spinner fa-spin me-1" t-if="state.isCapturing"></i>
                    <t t-if="!state.isCapturing">Capturer Tout</t>
                    <t t-if="state.isCapturing">Capture...</t>
                </button>
            </div>

            <div class="o_threat_mapping_container">
                <!-- Tooltip -->
                <div t-if="tooltip and tooltip.visible and tooltip.content"
                     class="stakeholder-tooltip"
                     t-att-style="'left: ' + tooltip.x + 'px; top: ' + tooltip.y + 'px;'">
                    <div class="tooltip-title">
                        <t t-esc="tooltip.content.name"/>
                    </div>
                    <div class="tooltip-row">
                        <span class="tooltip-label">Type:</span>
                        <span class="tooltip-value"><t t-esc="tooltip.content.threatType"/></span>
                    </div>
                    <div class="tooltip-row">
                        <span class="tooltip-label">Catégorie:</span>
                        <span class="tooltip-value"><t t-esc="tooltip.content.category"/></span>
                    </div>
                    <div class="tooltip-row">
                        <span class="tooltip-label">Niveau de menace:</span>
                        <span class="tooltip-value"><t t-esc="tooltip.content.threatLevel"/></span>
                    </div>
                    <div class="tooltip-row">
                        <span class="tooltip-label">Zone de risque:</span>
                        <span class="tooltip-value"><t t-esc="tooltip.content.riskZone"/></span>
                    </div>
                    <div class="tooltip-row">
                        <span class="tooltip-label">Exposition:</span>
                        <span class="tooltip-value"><t t-esc="tooltip.content.exposition"/></span>
                    </div>
                    <div class="tooltip-row">
                        <span class="tooltip-label">Fiabilité Cyber:</span>
                        <span class="tooltip-value"><t t-esc="tooltip.content.cyberReliability"/></span>
                    </div>
                </div>

                <!-- Two Cartographies Side by Side -->
                <div class="o_dual_cartographies">
                    <!-- Actual Threat Cartography -->
                    <div class="o_cartography_panel" id="actual-cartography">
                            <h3 class="cartography-title">Menace Actuelle</h3>
                        <svg class="o_threat_mapping_svg" viewBox="0 0 500 500">
                            <!-- Background and Grid -->
                            <g class="o_threat_mapping_background">
                                <circle cx="250" cy="250" r="200" class="grid-circle outer-circle"/>
                                <circle cx="250" cy="250" r="176.875" class="grid-circle"/>
                                <circle cx="250" cy="250" r="142.188" class="grid-circle"/>
                                <circle cx="250" cy="250" r="84.375" class="grid-circle"/>
                                <circle cx="250" cy="250" r="15" class="grid-circle center-circle"/>

                                <line x1="250" y1="50" x2="250" y2="450" class="axis-line"/>
                                <line x1="50" y1="250" x2="450" y2="250" class="axis-line"/>
                            </g>

                            <!-- Zones Circles -->
                            <g class="o_threat_mapping_zones">
                                <circle cx="250" cy="250" r="200" class="zone-veille"/>
                                <circle cx="250" cy="250" r="176.875" class="zone-control"/>
                                <circle cx="250" cy="250" r="142.188" class="zone-danger"/>
                            </g>

                            <!-- Category Labels -->
                            <g class="o_threat_mapping_categories">
                                <text x="400" y="70" class="category-label">Partenaires</text>
                                <text x="40" y="460" class="category-label">Prestataires</text>
                                <text x="40" y="70" class="category-label">Clients</text>
                                <text x="390" y="460" class="category-label">Personnels</text>
                            </g>

                            <!-- Threat Level Numbers -->
                            <g class="o_threat_mapping_levels">
                                <text x="255" y="455" class="level-number">0</text>
                                <text x="255" y="431" class="level-number">2</text>
                                <text x="255" y="397" class="level-number">5</text>
                                <text x="255" y="339" class="level-number">10</text>
                                <text x="255" y="270" class="level-number">16</text>
                            </g>

                            <!-- Stakeholder Markers -->
                            <g class="o_threat_mapping_stakeholders">
                                <t t-foreach="renderThreatChart('actual')" t-as="stakeholder" t-key="stakeholder.id">
                                    <circle
                                        t-att-cx="calculateStakeholderX(stakeholder)"
                                        t-att-cy="calculateStakeholderY(stakeholder)"
                                        t-att-r="getStakeholderRadius(stakeholder)"
                                        class="stakeholder-marker"
                                        t-att-style="'fill: ' + getStakeholderColor(stakeholder)"
                                        t-on-mouseenter.stop="(ev) => this.showTooltip(ev, stakeholder)"
                                        t-on-mouseleave.stop="() => this.hideTooltip()"
                                        t-on-mousemove.stop="(ev) => this.showTooltip(ev, stakeholder)"
                                    />
                                    <text
                                        t-att-x="calculateStakeholderX(stakeholder) + getStakeholderRadius(stakeholder) + 3"
                                        t-att-y="calculateStakeholderY(stakeholder) + 3"
                                        class="stakeholder-label"
                                    >
                                        <t t-esc="stakeholder.abbreviation"/>
                                    </text>
                                </t>
                            </g>
                        </svg>
                    </div>

                    <!-- Residual Threat Cartography -->
                    <div class="o_cartography_panel" id="residual-cartography">
                            <h3 class="cartography-title">Menace Résiduelle</h3>
                        <svg class="o_threat_mapping_svg" viewBox="0 0 500 500">
                            <!-- Background and Grid -->
                            <g class="o_threat_mapping_background">
                                <circle cx="250" cy="250" r="200" class="grid-circle outer-circle"/>
                                <circle cx="250" cy="250" r="176.875" class="grid-circle"/>
                                <circle cx="250" cy="250" r="142.188" class="grid-circle"/>
                                <circle cx="250" cy="250" r="84.375" class="grid-circle"/>
                                <circle cx="250" cy="250" r="15" class="grid-circle center-circle"/>

                                <line x1="250" y1="50" x2="250" y2="450" class="axis-line"/>
                                <line x1="50" y1="250" x2="450" y2="250" class="axis-line"/>
                            </g>

                            <!-- Zones Circles -->
                            <g class="o_threat_mapping_zones">
                                <circle cx="250" cy="250" r="200" class="zone-veille"/>
                                <circle cx="250" cy="250" r="176.875" class="zone-control"/>
                                <circle cx="250" cy="250" r="142.188" class="zone-danger"/>
                            </g>

                            <!-- Category Labels -->
                            <g class="o_threat_mapping_categories">
                                <text x="400" y="70" class="category-label">Partenaires</text>
                                <text x="40" y="460" class="category-label">Prestataires</text>
                                <text x="40" y="70" class="category-label">Clients</text>
                                <text x="390" y="460" class="category-label">Personnels</text>
                            </g>

                            <!-- Threat Level Numbers -->
                            <g class="o_threat_mapping_levels">
                                <text x="255" y="455" class="level-number">0</text>
                                <text x="255" y="431" class="level-number">2</text>
                                <text x="255" y="397" class="level-number">5</text>
                                <text x="255" y="339" class="level-number">10</text>
                                <text x="255" y="270" class="level-number">16</text>
                            </g>

                            <!-- Stakeholder Markers -->
                            <g class="o_threat_mapping_stakeholders">
                                <t t-foreach="renderThreatChart('residual')" t-as="stakeholder" t-key="stakeholder.id">
                                    <circle
                                        t-att-cx="calculateStakeholderX(stakeholder)"
                                        t-att-cy="calculateStakeholderY(stakeholder)"
                                        t-att-r="getStakeholderRadius(stakeholder)"
                                        class="stakeholder-marker"
                                        t-att-style="'fill: ' + getStakeholderColor(stakeholder)"
                                        t-on-mouseenter.stop="(ev) => this.showTooltip(ev, stakeholder)"
                                        t-on-mouseleave.stop="() => this.hideTooltip()"
                                        t-on-mousemove.stop="(ev) => this.showTooltip(ev, stakeholder)"
                                    />
                                    <text
                                        t-att-x="calculateStakeholderX(stakeholder) + getStakeholderRadius(stakeholder) + 3"
                                        t-att-y="calculateStakeholderY(stakeholder) + 3"
                                        class="stakeholder-label"
                                    >
                                        <t t-esc="stakeholder.abbreviation"/>
                                    </text>
                                </t>
                            </g>
                        </svg>
                    </div>
                </div>

                <!-- Horizontal Legend Below -->
                <div class="o_threat_mapping_legend_horizontal" id="legend-section">
                    <div class="legend-section">
                        <h4>Exposition</h4>
                        <div class="legend-items">
                            <div class="legend-item">
                                <svg width="20" height="20">
                                    <circle cx="10" cy="10" r="4" class="exposure-marker"/>
                                </svg>
                                <span>&lt; 3</span>
                            </div>
                            <div class="legend-item">
                                <svg width="20" height="20">
                                    <circle cx="10" cy="10" r="6" class="exposure-marker"/>
                                </svg>
                                <span>3-6</span>
                            </div>
                            <div class="legend-item">
                                <svg width="20" height="20">
                                    <circle cx="10" cy="10" r="8" class="exposure-marker"/>
                                </svg>
                                <span>7-9</span>
                            </div>
                            <div class="legend-item">
                                <svg width="20" height="20">
                                    <circle cx="10" cy="10" r="10" class="exposure-marker"/>
                                </svg>
                                <span>&gt; 9</span>
                            </div>
                        </div>
                    </div>

                    <div class="legend-section">
                        <h4>Fiabilité Cyber</h4>
                        <div class="legend-items">
                            <div class="legend-item">
                                <div class="color-marker red"></div>
                                <span>&lt; 4</span>
                            </div>
                            <div class="legend-item">
                                <div class="color-marker yellow"></div>
                                <span>4-5</span>
                            </div>
                            <div class="legend-item">
                                <div class="color-marker blue"></div>
                                <span>6-7</span>
                            </div>
                            <div class="legend-item">
                                <div class="color-marker green"></div>
                                <span>&gt; 7</span>
                            </div>
                        </div>
                    </div>

                    <div class="legend-section">
                        <h4>Zones de Risque</h4>
                        <div class="legend-items">
                            <div class="legend-item">
                                <div class="zone-marker danger"></div>
                                <span>Zone de danger</span>
                            </div>
                            <div class="legend-item">
                                <div class="zone-marker control"></div>
                                <span>Zone de contrôle</span>
                            </div>
                            <div class="legend-item">
                                <div class="zone-marker veille"></div>
                                <span>Zone de veille</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>