<templates xml:space="preserve">
    <t t-name="digiit_ebios_rm.ROTORadarCartography" owl="1">
        <div class="o_roto_radar_chart">
            <!-- Header Panel -->
            <!-- Header Panel -->
            <div class="control-panel p-2 bg-light border-bottom d-flex align-items-center justify-content-between">
                <button class="btn btn-secondary" t-on-click="goBack">
                    <i class="fa fa-arrow-left me-1"></i>Retour
                </button>

                <span class="fw-bold fs-4">Cartographie Radar SR/OV</span>

                <button class="btn btn-primary" t-on-click="captureAll"
                        t-att-disabled="state.isCapturing">
                    <i class="fa fa-camera me-1" t-if="!state.isCapturing"></i>
                    <i class="fa fa-spinner fa-spin me-1" t-if="state.isCapturing"></i>
                    <t t-if="!state.isCapturing">Capturer Tout</t>
                    <t t-if="state.isCapturing">Capture...</t>
                </button>
            </div>

            <div class="o_roto_radar_container">
                <!-- Main Charts Container (side by side) -->
                <div class="o_roto_radar_charts">
                    <!-- LEFT CHART: View by Risk Origins -->
                    <div class="o_roto_radar_chart_wrapper" id="risk-origin-chart">
                        <h2 class="chart-title">Vision par Source de Risque</h2>
                        <svg class="o_roto_radar_svg" viewBox="0 0 500 500">
                            <!-- Background Grid -->
                            <g class="o_roto_radar_background">
                                <!-- Concentric circles for pertinence levels (NOW COLORED) -->
                                <t t-foreach="getPertinenceCircles()" t-as="circle" t-key="circle.level.id" >
                                    <circle cx="250" cy="250"
                                            t-att-r="circle.radius"
                                            class="grid-circle"
                                            t-att-stroke="circle.level.color || '#c0c0c0'"/>
                                </t>

                                <!-- Sector lines -->
                                <t t-foreach="state.riskOrigins" t-as="origin" t-key="origin.id">
                                    <t t-set="angle" t-value="origin_index * (360 / state.riskOrigins.length)"/>
                                    <t t-set="pos" t-value="polarToCartesian(250, 250, 200, angle)"/>
                                    <line x1="250" y1="250" t-att-x2="pos.x" t-att-y2="pos.y" class="sector-line"/>
                                </t>
                            </g>

                            <!-- Sector Labels (Risk Origins) with abbreviations -->
                            <g class="o_roto_radar_labels">
                                <t t-foreach="getOriginSectorLabels()" t-as="label" t-key="label.origin.id">
                                    <text t-att-x="label.x" t-att-y="label.y"
                                          class="sector-label" text-anchor="middle">
                                        <title><t t-esc="label.origin.name"/></title>
                                        <t t-esc="label.abbreviation"/>
                                    </text>
                                </t>
                            </g>

                            <!-- Pertinence Level Numbers -->
                            <g class="o_roto_radar_levels">
                                <t t-foreach="getPertinenceCircles()" t-as="circle" t-key="circle.level.id">
                                    <t t-set="pos" t-value="polarToCartesian(250, 250, circle.radius, 145)"/>
                                        <text t-att-x="pos.x" t-att-y="pos.y + 4"
                                              class="level-number"
                                              text-anchor="middle">
                                            <t t-esc="circle.level.number"/>
                                        </text>
                                </t>
                            </g>

                            <!-- Data Points (Target Objectives in Risk Origin sectors) -->
                            <g class="o_roto_radar_points">
                                <t t-foreach="renderLeftChartData()" t-as="pair" t-key="pair.id">
                                    <circle
                                        t-att-cx="pair.x"
                                        t-att-cy="pair.y"
                                        r="7"
                                        t-att-class="'data-point ' + (pair.held ? 'retained' : 'non-retained')"
                                        t-att-style="'fill: ' + getPairColor(pair)"
                                    >
                                        <title><t t-esc="pair.targeted_objectif_name"/></title>
                                    </circle>
                                    <text
                                        t-att-x="pair.x + 10"
                                        t-att-y="pair.y + 3"
                                        class="data-label"
                                    >
                                        <title><t t-esc="pair.targeted_objectif_name"/></title>
                                        <t t-esc="getObjectiveAbbreviation(pair.targeted_objectif_id[0])"/>
                                    </text>
                                </t>
                            </g>
                        </svg>
                    </div>

                    <!-- RIGHT CHART: View by Target Objectives -->
                    <div class="o_roto_radar_chart_wrapper"  id="target-objective-chart">
                        <h2 class="chart-title">Vision par Objectif Visé</h2>
                        <svg class="o_roto_radar_svg" viewBox="0 0 500 500">
                            <!-- Background Grid -->
                            <g class="o_roto_radar_background">
                                <!-- Concentric circles for pertinence levels (NOW COLORED) -->
                                <t t-foreach="getPertinenceCircles()" t-as="circle" t-key="circle.level.id">
                                    <circle cx="250" cy="250"
                                            t-att-r="circle.radius"
                                            class="grid-circle"
                                            t-att-stroke="circle.level.color || '#c0c0c0'"/>
                                </t>

                                <!-- Sector lines -->
                                <t t-foreach="state.targetObjectives" t-as="objective" t-key="objective.id">
                                    <t t-set="angle" t-value="objective_index * (360 / state.targetObjectives.length)"/>
                                    <t t-set="pos" t-value="polarToCartesian(250, 250, 200, angle)"/>
                                    <line x1="250" y1="250" t-att-x2="pos.x" t-att-y2="pos.y" class="sector-line"/>
                                </t>
                            </g>

                            <!-- Sector Labels (Target Objectives) with abbreviations -->
                            <g class="o_roto_radar_labels">
                                <t t-foreach="getObjectiveSectorLabels()" t-as="label" t-key="label.objective.id">
                                    <text t-att-x="label.x" t-att-y="label.y"
                                          class="sector-label" text-anchor="middle">
                                        <title><t t-esc="label.objective.name"/></title>
                                        <t t-esc="label.abbreviation"/>
                                    </text>
                                </t>
                            </g>

                            <!-- Pertinence Level Numbers -->
                            <g class="o_roto_radar_levels">
                                <t t-foreach="getPertinenceCircles()" t-as="circle" t-key="circle.level.id">
                                    <t t-set="pos" t-value="polarToCartesian(250, 250, circle.radius, 145)"/>
                                        <text t-att-x="pos.x" t-att-y="pos.y + 4"
                                              class="level-number"
                                              text-anchor="middle">
                                            <t t-esc="circle.level.number"/>
                                        </text>
                                </t>
                            </g>

                            <!-- Data Points (Risk Origins in Target Objective sectors) -->
                            <g class="o_roto_radar_points">
                                <t t-foreach="renderRightChartData()" t-as="pair" t-key="pair.id">
                                    <circle
                                        t-att-cx="pair.x"
                                        t-att-cy="pair.y"
                                        r="7"
                                        t-att-class="'data-point ' + (pair.held ? 'retained' : 'non-retained')"
                                        t-att-style="'fill: ' + getPairColor(pair)"
                                    >
                                        <title><t t-esc="pair.source_of_risk_name"/></title>
                                    </circle>
                                    <text
                                        t-att-x="pair.x + 10"
                                        t-att-y="pair.y + 3"
                                        class="data-label"
                                    >
                                        <title><t t-esc="pair.source_of_risk_name"/></title>
                                        <t t-esc="getOriginAbbreviation(pair.source_of_risk_id[0])"/>
                                    </text>
                                </t>
                            </g>
                        </svg>
                    </div>
                </div>

                <!-- Legend Container (bottom, horizontal) -->
                <div class="o_roto_radar_legend">
                    <!-- legend parts-->
                    <div id="legend-section" class="legend-horizontal-wrapper">
                        <div class="legend-section">
                            <h3>Statut des paires</h3>
                            <div class="legend-status">
                                <div class="legend-item">
                                    <div class="status-marker retained"></div>
                                    <span>Paire retenue</span>
                                </div>
                                <div class="legend-item">
                                    <div class="status-marker non-retained"></div>
                                    <span>Paire non retenue</span>
                                </div>
                            </div>
                        </div>

                        <div class="legend-section">
                            <h3>Niveaux de Pertinence</h3>
                            <div class="legend-pertinence">
                                <t t-foreach="state.pertinenceLevels" t-as="level" t-key="level.id">
                                    <div class="legend-item">
                                        <div class="pertinence-marker" t-att-style="'background-color: ' + (level.color || '#999')"></div>
                                        <span><t t-esc="level.name"/> (Niveau <t t-esc="level.number"/>)</span>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <div class="legend-section">
                            <h3>Sources de Risques</h3>
                            <div class="legend-origins">
                                <t t-foreach="state.riskOrigins" t-as="origin" t-key="origin_index">
                                    <div class="legend-item">
                                        <span class="origin-label"><strong>SR<t t-esc="origin_index + 1"/>:</strong> <t t-esc="origin.name"/></span>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <div class="legend-section">
                            <h3>Objectifs Visés</h3>
                            <div class="legend-objectives">
                                <t t-foreach="state.targetObjectives" t-as="objective" t-key="objective_index">
                                    <div class="legend-item">
                                        <span class="objective-label"><strong>OV<t t-esc="objective_index + 1"/>:</strong> <t t-esc="objective.name"/></span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Reference Table -->
                    <div class="legend-section reference-section">
                        <h3>Table de référence</h3>
                        <div class="reference-table">
                            <table>
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Source</th>
                                        <th>Objectif</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.riskSources" t-as="pair" t-key="pair.id">
                                        <tr class="reference-row">
                                            <td><t t-esc="pair.prefixed_identifier"/></td>
                                            <td>
                                                <strong><t t-esc="getOriginAbbreviation(pair.source_of_risk_id[0])"/>:</strong>
                                                <t t-esc="pair.source_of_risk_name"/>
                                            </td>
                                            <td>
                                                <strong><t t-esc="getObjectiveAbbreviation(pair.targeted_objectif_id[0])"/>:</strong>
                                                <t t-esc="pair.targeted_objectif_name"/>
                                            </td>
                                            <td>
                                                <span t-if="pair.held" class="badge-retained">✓</span>
                                                <span t-else="" class="badge-non-retained">○</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Selected Pair Details Panel -->
            <div t-if="state.selectedPair" class="pair-details mt-3 p-3 border rounded">
                <h4>
                    <t t-esc="state.selectedPair.prefixed_identifier"/> -
                    <t t-esc="state.selectedPair.source_of_risk_name"/> /
                    <t t-esc="state.selectedPair.targeted_objectif_name"/>
                </h4>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Source de Risque:</strong> <t t-esc="state.selectedPair.source_of_risk_name"/></p>
                        <p><strong>Objectif Visé:</strong> <t t-esc="state.selectedPair.targeted_objectif_name"/></p>
                        <p><strong>Statut:</strong>
                            <span t-if="state.selectedPair.held" class="badge bg-danger">Retenue</span>
                            <span t-else="" class="badge bg-success">Non retenue</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Pertinence:</strong>
                            <t t-if="state.selectedPair.pertinence_retenue_id">
                                <t t-esc="state.selectedPair.pertinence_retenue_id[1]"/>
                            </t>
                            <t t-elif="state.selectedPair.pertinence_id">
                                <t t-esc="state.selectedPair.pertinence_id[1]"/>
                            </t>
                        </p>
                    </div>
                </div>
                <div t-if="state.selectedPair.description">
                    <h5>Description:</h5>
                    <div t-raw="state.selectedPair.description"/>
                </div>
                <div t-if="state.selectedPair.justification">
                    <h5>Justification:</h5>
                    <div t-raw="state.selectedPair.justification"/>
                </div>
            </div>
        </div>
    </t>
</templates>