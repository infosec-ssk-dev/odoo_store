<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_digiit_timbre" model="ir.ui.view">
        <field name="name">account.move.form.inherit.digiit.timbre</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add after the currency_id field in currency_div -->
            <xpath expr="//div[@name='journal_div']" position="after">
                <div class="o_row">
                    <label for="digiit_timbre_fiscal" string="Timbre Fiscal" class="fw-bold"/>
                    <field name="digiit_timbre_fiscal"
                           string="Timbre Fiscal"
                           help="Include 1DT Timbre Fiscal in the invoice total" widget="boolean_toggle" readonly="state != 'draft'"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>