<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_digiit_timbre" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.digiit.timbre</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='fiscal_information']" position="inside">
                    <field name="digiit_exemption_timbre_fiscal"
                           string="Exception du timbre fiscal"
                           widget="boolean_toggle"
                           invisible="not is_company"/>
            </xpath>
        </field>
    </record>
</odoo>
