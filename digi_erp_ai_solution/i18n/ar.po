#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/tools.py:0
msgid ""
"%(model)s.%(method)s runs on records: put the ids first, in args[0] — for "
"example args: [[42], {\"name\": \"…\"}]."
msgstr ""
"%(model)s.%(method)s تعمل على سجلات: ضع المعرّفات أولاً في args[0] — مثال: "
"args: [[42], {\"name\": \"…\"}]."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/controllers/main.py:0
msgid ""
"%(name)s cannot read images. Tick \"Can read images (OCR / vision)\" on that"
" model if it supports vision, or choose an OCR AI model under Settings → "
"DIGI-ERP AI."
msgstr ""
"%(name)s لا يستطيع قراءة الصور. فعّل خيار «يستطيع قراءة الصور (OCR / رؤية)» "
"على هذا النموذج إن كان يدعم الرؤية، أو اختر نموذج ذكاء اصطناعي للتعرّف "
"الضوئي من الإعدادات ← DIGI-ERP AI."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s could not answer this request (error %(status)s). The details are "
"in the Odoo log."
msgstr ""
"تعذّر على %(name)s الإجابة عن هذا الطلب (خطأ %(status)s). التفاصيل في سجل "
"Odoo."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s could not be reached. The details are in the Odoo log (Settings → "
"Technical → Logging)."
msgstr ""
"تعذّر الوصول إلى %(name)s. التفاصيل في سجل Odoo (الإعدادات ← تقني ← "
"السجلات)."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/controllers/main.py:0
msgid "%(name)s could not read the image: %(err)s"
msgstr "تعذّر على %(name)s قراءة الصورة: %(err)s"

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s does not recognise the model “%(model)s”. An administrator can "
"correct the model name under DIGI-ERP AI → AI Models."
msgstr ""
"لا يتعرّف %(name)s على النموذج «%(model)s». يمكن للمسؤول تصحيح اسم النموذج "
"من DIGI-ERP AI ← نماذج الذكاء الاصطناعي."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s has no Base URL. An administrator can add it under DIGI-ERP AI → AI"
" Models."
msgstr ""
"لا يوجد عنوان أساسي لـ %(name)s. يمكن للمسؤول إضافته من DIGI-ERP AI ← نماذج "
"الذكاء الاصطناعي."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s is busy or its usage limit has been reached. Please try again in a "
"moment."
msgstr "%(name)s مشغول أو بلغ حدّ الاستخدام. أعد المحاولة بعد قليل."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s is having trouble on its side right now. Please try again in a "
"moment."
msgstr "يواجه %(name)s مشكلة من جهته حالياً. أعد المحاولة بعد قليل."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s is not set up to read images. Tick \"Can read images (OCR / "
"vision)\" on that model if it supports vision, or pick another one to read "
"documents under Settings → DIGI-ERP AI."
msgstr ""
"%(name)s غير مهيّأ لقراءة الصور. فعّل خيار «يستطيع قراءة الصور (OCR / رؤية)»"
" على هذا النموذج إن كان يدعم الرؤية، أو اختر نموذجاً آخر لقراءة المستندات من"
" الإعدادات ← DIGI-ERP AI."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s is set to a provider DIGI-ERP AI does not know (%(kind)s). An "
"administrator can correct it under DIGI-ERP AI → AI Models."
msgstr ""
"%(name)s مرتبط بمزوّد لا يعرفه DIGI-ERP AI (%(kind)s). يمكن للمسؤول تصحيحه "
"من DIGI-ERP AI ← نماذج الذكاء الاصطناعي."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s refused the connection: its API key is missing, wrong or expired. "
"An administrator can fix it under DIGI-ERP AI → AI Models."
msgstr ""
"رفض %(name)s الاتصال: مفتاح API مفقود أو غير صحيح أو منتهي الصلاحية. يمكن "
"للمسؤول تصحيحه من DIGI-ERP AI ← نماذج الذكاء الاصطناعي."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s rejected the request: the account has no credit left, or the "
"message is too large. An administrator can check the account."
msgstr ""
"رفض %(name)s الطلب: لا يوجد رصيد في الحساب، أو الرسالة كبيرة جداً. يمكن "
"للمسؤول التحقّق من الحساب."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid "%(name)s returned an empty answer. Please try asking again."
msgstr "أعاد %(name)s إجابة فارغة. حاول طرح السؤال مرة أخرى."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s took too long to answer. Try a shorter question, or raise the "
"answer timeout under Settings → DIGI-ERP AI."
msgstr ""
"استغرق %(name)s وقتاً طويلاً للإجابة. اطرح سؤالاً أقصر، أو ارفع مهلة الإجابة"
" من الإعدادات ← DIGI-ERP AI."

