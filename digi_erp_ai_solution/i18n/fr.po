#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s does not recognise the model “%(model)s”. An administrator can "
"correct the model name under DIGI-ERP AI → AI Models."
msgstr ""
"%(name)s ne reconnaît pas le modèle « %(model)s ». Un administrateur peut "
"corriger le nom du modèle dans DIGI-ERP AI → Modèles d'IA."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
msgid ""
"%(name)s has no Base URL. An administrator can add it under DIGI-ERP AI → AI"
" Models."
msgstr ""
"%(name)s n'a pas d'URL de base. Un administrateur peut l'ajouter dans DIGI-"
