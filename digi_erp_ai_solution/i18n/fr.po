#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/tools.py:0
msgid ""
"%(model)s.%(method)s runs on records: put the ids first, in args[0] — for "
"example args: [[42], {\"name\": \"…\"}]."
msgstr ""
"%(model)s.%(method)s s'applique à des enregistrements : indiquez d'abord les"
" identifiants, dans args[0] — par exemple args : [[42], {\"name\": \"…\"}]."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/controllers/main.py:0
msgid ""
"%(name)s cannot read images. Tick \"Can read images (OCR / vision)\" on that"
" model if it supports vision, or choose an OCR AI model under Settings → "
"DIGI-ERP AI."
msgstr ""
"%(name)s ne peut pas lire les images. Cochez « Peut lire les images (OCR / "
"vision) » sur ce modèle s'il gère la vision, ou choisissez un modèle d'IA "
"pour l'OCR dans Paramètres → DIGI-ERP AI."

#. module: digi_erp_ai_solution
#. odoo-python
#: code:addons/digi_erp_ai_solution/services/llm_providers.py:0
