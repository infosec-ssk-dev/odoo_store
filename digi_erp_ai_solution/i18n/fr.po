#. module: digi_erp_ai_solution
msgid ""
".\n"
"                                    I am <strong>DIGI-ERP AI</strong>.\n"
"                                    Ask me anything about your Odoo — I "
"build the\n"
"                                    query myself and Odoo answers, always "
"within\n"
"                                    the limits of your own permissions."
msgstr ""
".\n"
"                                    Je suis <strong>DIGI-ERP AI</strong>.\n"
"                                    Posez-moi n'importe quelle question sur"
" votre Odoo — je construis\n"
"                                    la requête moi-même et Odoo répond, "
"toujours dans\n"
"                                    les limites de vos propres droits."

#. module: digi_erp_ai_solution
msgid ""
".\n"
"                        You can see that this conversation exists and how "
"big\n"
"                        it is, and you can delete it — you cannot read it."
msgstr ""
".\n"
"                        Vous pouvez voir que cette conversation existe et "
"quelle\n"
"                        taille elle fait, et vous pouvez la supprimer — "
"vous ne pouvez pas la lire."

