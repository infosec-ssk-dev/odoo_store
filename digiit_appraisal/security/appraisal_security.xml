<odoo>
    <!-- Multi-company rules -->
    <record id="appraisal_multi_company_rule" model="ir.rule">
        <field name="name">Appraisal: multi-company</field>
        <field name="model_id" ref="model_digiit_model_appraisal"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>

    <record id="appraisal_rule_hr_full_access" model="ir.rule">
        <field name="name">Appraisal Full Access for HR</field>
        <field name="model_id" ref="model_digiit_model_appraisal"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="appraisal_rule_limited_access" model="ir.rule">
        <field name="name">Appraisal Access for Employee or Manager</field>
        <field name="model_id" ref="model_digiit_model_appraisal"/>
        <field name="domain_force">
            ['|', ('employee_id.user_id', '=', user.id), ('manager_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="appraisal_skill_rule_hr_full_access" model="ir.rule">
        <field name="name">Appraisal Skill Full Access for HR</field>
        <field name="model_id" ref="model_digiit_model_appraisal_skill"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="appraisal_skill_rule_manager_access" model="ir.rule">
        <field name="name">Appraisal Skill Access for Manager</field>
        <field name="model_id" ref="model_digiit_model_appraisal_skill"/>
        <field name="domain_force">
            [('appraisal_id.manager_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="appraisal_skill_rule_employee_limited_access" model="ir.rule">
        <field name="name">Appraisal Skill Access for Employee</field>
        <field name="model_id" ref="model_digiit_model_appraisal_skill"/>
        <field name="domain_force">
            [('appraisal_id.employee_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="appraisal_objective_rule_hr_full_access" model="ir.rule">
        <field name="name">Appraisal Objective Full Access for HR</field>
        <field name="model_id" ref="model_digiit_model_objective"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="appraisal_objective_rule_limited_access" model="ir.rule">
        <field name="name">Appraisal Objective Access employee</field>
        <field name="model_id" ref="model_digiit_model_objective"/>
        <field name="domain_force">
            ['|', ('employee_id.user_id', '=', user.id), ('manager_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Multi-company rule for AppraisalObjective -->
    <record id="appraisal_objective_multi_company_rule" model="ir.rule">
        <field name="name">Appraisal Objective: multi-company</field>
        <field name="model_id" ref="model_digiit_model_objective"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('employee_id.company_id','in',company_ids)]</field>
    </record>

    <record id="survey_feedback360_read_all_users" model="ir.rule">
        <field name="name">Survey: read access for all users on feedback360 surveys</field>
        <field name="model_id" ref="survey.model_survey_survey"/>
        <field name="domain_force">['|',
            ('is_feedback360_template', '=', True),
            ('is_feedback360', '=', True)
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="survey_feedback360_manager_write_access" model="ir.rule">
        <field name="name">Survey: write access for manager of evaluated employee (feedback360)</field>
        <field name="model_id" ref="survey.model_survey_survey"/>
        <field name="domain_force">[('is_feedback360', '=', True), ('feedback360_appraisal_id.manager_id.user_id', '=',
            user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="survey_user_input_feedback360_read_all_users" model="ir.rule">
        <field name="name">Survey User Input: read access for all users on feedback360 surveys</field>
        <field name="model_id" ref="survey.model_survey_user_input"/>
        <field name="domain_force">[('survey_id.is_feedback360', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="survey_question_feedback360_manager_write_access" model="ir.rule">
        <field name="name">Survey Question: manager write access (feedback360)</field>
        <field name="model_id" ref="survey.model_survey_question"/>
        <field name="domain_force">
            ['|',
            ('survey_id.is_feedback360_template', '=', True),
            '&amp;',
            ('survey_id.is_feedback360', '=', True),
            ('survey_id.feedback360_appraisal_id.manager_id.user_id', '=', user.id)
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="survey_question_answer_feedback360_manager_write_access" model="ir.rule">
        <field name="name">Survey Question Answer: manager write access (feedback360)</field>
        <field name="model_id" ref="survey.model_survey_question_answer"/>
        <field name="domain_force">
            ['|',
            ('question_id.survey_id.is_feedback360_template', '=', True),
            '&amp;',
            ('question_id.survey_id.is_feedback360', '=', True),
            ('question_id.survey_id.feedback360_appraisal_id.manager_id.user_id', '=', user.id)
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="survey_question_feedback360_read_all_users" model="ir.rule">
        <field name="name">Survey Question: read access for all users on feedback360 surveys</field>
        <field name="model_id" ref="survey.model_survey_question"/>
        <field name="domain_force">[('survey_id.is_feedback360', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="survey_question_answer_feedback360_read_all_users" model="ir.rule">
        <field name="name">Survey Question Answer: read access for all users on feedback360 surveys</field>
        <field name="model_id" ref="survey.model_survey_question_answer"/>
        <field name="domain_force">[('question_id.survey_id.is_feedback360', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Multi-company rules for template and settings only -->
    <record id="appraisal_template_multi_company_rule" model="ir.rule">
        <field name="name">Appraisal Template: multi-company</field>
        <field name="model_id" ref="model_digiit_model_appraisal_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id','in', company_ids + [False])]</field>
    </record>

    <record id="appraisal_settings_multi_company_rule" model="ir.rule">
        <field name="name">Appraisal Settings: multi-company</field>
        <field name="model_id" ref="model_digiit_model_appraisal_settings"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id','in', company_ids + [False])]</field>
    </record>

    <!-- Multi-company rules for feedback360 models -->
    <record id="feedback360_participant_multi_company_rule" model="ir.rule">
        <field name="name">Feedback360 Participant: multi-company</field>
        <field name="model_id" ref="model_digiit_model_feedback360_participant"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('appraisal_id.company_id','in',company_ids)]</field>
    </record>

</odoo>