<odoo>
    <!-- Vue Formulaire -->
    <record id="view_objective_form" model="ir.ui.view">
        <field name="name">digiit.model.objective.form</field>
        <field name="model">digiit.model.objective</field>
        <field name="arch" type="xml">
            <form string="Objectif">
                <header>
                    <button string="Marquer comme fait" type="object" name="action_mark_done" class="btn-primary"
                            invisible="progress=='100'"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Fait" bg_color="bg-success" invisible="progress != '100'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="is_employee" placeholder="ex : Améliorer le niveau d'anglais"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="is_employee"/>
                            <field name="progress" readonly="is_employee" widget="radio"/>
                        </group>
                        <group>
                            <field name="manager_id" readonly="1"/>
                            <field name="create_date" string="Créé le"/>
                            <field name="date_deadline" readonly="is_employee"/>
                            <field name="tag_ids" readonly="is_employee" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" readonly="is_employee"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue Liste -->
    <record id="view_objective_list" model="ir.ui.view">
        <field name="name">digiit.model.objective.list</field>
        <field name="model">digiit.model.objective</field>
        <field name="arch" type="xml">
            <list string="Objectifs">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="progress"/>
                <field name="create_date" string="Créé le"/>
                <field name="date_deadline"/>
                <field name="manager_id" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vue search -->
    <record id="view_objective_search" model="ir.ui.view">
        <field name="name">digiit.model.objective.search</field>
        <field name="model">digiit.model.objective</field>
        <field name="arch" type="xml">
            <search string="Objectifs">

                <!-- Quick Filters -->
                <filter name="my_objectives" string="Mes objectifs" domain="[('employee_id.user_id','=',uid)]"/>
                <filter name="team_objectives" string="Personnes de mon équipe"
                        domain="[('manager_id.user_id','=',uid)]"/>
                <separator/>
                <filter name="in_progress" string="En cours" domain="[('progress','!=','100')]"/>
                <filter name="done" string="Fait" domain="[('progress','=','100')]"/>
                <separator/>
                <filter name="late" string="En retard" domain="[('date_deadline','&lt;', context_today())]"
                        help="Objectifs dont la date limite est dépassée"/>

                <!-- Group By Filters -->
                <filter name="grp_create_month" string="Créé le" context="{'group_by':'create_date'}"/>


                <filter name="grp_deadline_month" string="Date limite"
                        context="{'group_by':'date_deadline'}"/>

                <filter name="grp_employee" string="Employé" context="{'group_by':'employee_id'}"/>
                <filter name="grp_manager" string="Manager" context="{'group_by':'manager_id'}"/>


                <!-- Search Fields -->
                <field name="name" string="Objectif"/>
                <field name="employee_id"/>
                <field name="tag_ids"/>

            </search>
        </field>
    </record>

    <!-- Vue kanban -->
    <record id="view_objective_kanban" model="ir.ui.view">
        <field name="name">digiit.model.objective.kanban</field>
        <field name="model">digiit.model.objective</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="progress"/>
                <field name="date_deadline"/>
                <field name="tag_ids"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <widget name="web_ribbon" title="Fait" bg_color="bg-success" invisible="progress != '100'"/>

                            <div class="d-flex justify-content-between mb-1">
                                <div>
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div style="height: 8px;" invisible="progress == '100'">
                                    <t t-esc="record.progress.raw_value + '%'"/>
                                </div>
                            </div>

                            <div class="text-muted mb-1">
                                <t t-esc="record.employee_id.value"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center text-muted mt-4 mb-2">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-clock-o mx-2"/>
                                    <t t-esc="record.date_deadline.value"/>
                                </div>
                                <img t-att-src="'/web/image/hr.employee/' + record.employee_id.raw_value + '/avatar_128'"
                                     class="rounded-circle" style="width: 32px; height: 32px;" alt="Avatar"/>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue graph -->
    <record id="view_objective_graph" model="ir.ui.view">
        <field name="name">digiit.model.objective.graph</field>
        <field name="model">digiit.model.objective</field>
        <field name="arch" type="xml">
            <graph string="Graphique des Objectifs" type="bar">
                <field name="employee_id" type="row"/>
                <field name="progress"/>
                <field name="date_deadline" type="col"/>
            </graph>
        </field>
    </record>


    <!-- Vue liste des étiquettes -->
    <record id="view_objective_tag_list" model="ir.ui.view">
        <field name="name">digiit.model.objective.tag.list</field>
        <field name="model">digiit.model.objective.tag</field>
        <field name="arch" type="xml">
            <list string="Étiquettes">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire étiquette -->
    <record id="view_objective_tag_form" model="ir.ui.view">
        <field name="name">digiit.model.objective.tag.form</field>
        <field name="model">digiit.model.objective.tag</field>
        <field name="arch" type="xml">
            <form string="Étiquette d'objectif">
                <field name="name"/>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_objective" model="ir.actions.act_window">
        <field name="name">Objectifs</field>
        <field name="res_model">digiit.model.objective</field>
        <field name="view_mode">list,form,kanban,graph</field>
        <field name="context">{'search_default_grp_employee': 1}</field>
    </record>

    <record id="action_objective_tag" model="ir.actions.act_window">
        <field name="name">Étiquettes d'objectif</field>
        <field name="res_model">digiit.model.objective.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
