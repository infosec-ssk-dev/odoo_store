<odoo>
    <record id="view_appraisal_settings_form" model="ir.ui.view">
        <field name="name">digiit.model.appraisal.settings.form</field>
        <field name="model">digiit.model.appraisal.settings</field>
        <field name="arch" type="xml">
            <form string="Paramètres des évaluations">
                <sheet>
                    <group>
                        <field name="company_id"/>
        show            <field name="default_template_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_appraisal_settings_list" model="ir.ui.view">
        <field name="name">digiit.model.appraisal.settings.list</field>
        <field name="model">digiit.model.appraisal.settings</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="default_template_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_appraisal_settings_list" model="ir.actions.act_window">
        <field name="name">Paramètres des évaluations</field>
        <field name="res_model">digiit.model.appraisal.settings</field>
        <field name="view_mode">list</field>
    </record>


</odoo>