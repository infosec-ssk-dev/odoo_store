<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template Views -->
    <record id="view_appraisal_template_form" model="ir.ui.view">
        <field name="name">digiit.model.appraisal_template.form</field>
        <field name="model">digiit.model.appraisal_template</field>
        <field name="arch" type="xml">
            <form string="Modèle d'évaluation">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" optional="show"/>
                    </group>
                    <group>
                        <group string="Section de l'employé">
                            <field name="employee_html" widget="html" nolabel="1"/>
                        </group>
                        <group string="Section du manager">
                            <field name="manager_html" widget="html" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_appraisal_template_list" model="ir.ui.view">
        <field name="name">digiit.model.appraisal_template.list</field>
        <field name="model">digiit.model.appraisal_template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_appraisal_template" model="ir.actions.act_window">
        <field name="name">Modèles d'évaluation</field>
        <field name="res_model">digiit.model.appraisal_template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>