<odoo>
    <record id="view_skill_type_list" model="ir.ui.view">
        <field name="name">digiit.model.skill_type.list</field>
        <field name="model">digiit.model.skill_type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="level_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="view_skill_type_form" model="ir.ui.view">
        <field name="name">digiit.model.skill_type.form</field>
        <field name="model">digiit.model.skill_type</field>
        <field name="arch" type="xml">
            <form string="Skills Type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <!-- COMPÉTENCES -->
                    <separator string="COMPÉTENCES"/>
                    <field name="tag_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </list>
                    </field>

                    <!-- NIVEAUX -->
                    <separator string="NIVEAUX"/>
                    <field name="level_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="progression" widget="progressbar"/>
                            <field name="is_default" widget="boolean_toggle"/>
                        </list>
                    </field>

                    <!-- AFFICHE -->
                    <separator string="AFFICHAGE"/>
                    <field name="color" widget="color_picker"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_skill_type" model="ir.actions.act_window">
        <field name="name">Skills Type</field>
        <field name="res_model">digiit.model.skill_type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
