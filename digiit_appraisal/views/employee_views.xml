<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enhanced Employee Form View -->
    <record id="view_employee_form_appraisal" model="ir.ui.view">
        <field name="name">hr.employee.form.appraisal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Statistics Button -->
                <button class="oe_stat_button" type="object" name="action_view_evaluations" icon="fa-line-chart">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="evaluations_stats"/>
                        </span>
                        <span class="o_stat_text">
                            Évaluations
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">

                <!-- Create Evaluation Button -->
                <button class="oe_stat_button" type="object" name="action_create_evaluation">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Créer Évaluation</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Enhanced Employee List View -->
    <record id="view_employee_list_appraisal" model="ir.ui.view">
        <field name="name">hr.employee.list.appraisal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="evaluations_completed" string="Éval. terminées"/>
                <field name="evaluations_planned" string="Éval. prévues"/>
            </xpath>
        </field>
    </record>

    <!-- Enhanced Employee Search View with Default Filters -->
    <record id="view_employee_search_appraisal" model="ir.ui.view">
        <field name="name">hr.employee.search.appraisal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter name="no_planned_evaluations" string="Sans évaluations Planifiées"
                        domain="[('evaluations_planned', '=', 0)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_employee_no_evaluations" model="ir.actions.act_window">
        <field name="name">Employees Without Evaluations</field>
        <field name="res_model">hr.employee</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'chat_icon': True, 'search_default_no_planned_evaluations': 1}</field>
        <field name="view_id" eval="False"/>
        <field name="search_view_id" ref="hr.view_employee_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new employee
            </p>
            <p>
                Quickly find all the information you need for your employees such as contact data, job position,
                availability, etc.
            </p>
        </field>
    </record>

    <!-- View mode associations -->
    <record id="act_employee_no_evaluations_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">kanban</field>
        <field name="act_window_id" ref="digiit_appraisal.action_employee_no_evaluations"/>
    </record>

    <record id="act_employee_no_evaluations_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
        <field name="view_mode">list</field>
        <field name="act_window_id" ref="digiit_appraisal.action_employee_no_evaluations"/>
    </record>

    <record id="act_employee_no_evaluations_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="digiit_appraisal.action_employee_no_evaluations"/>
    </record>
    <record id="act_employee_no_evaluations_activity" model="ir.actions.act_window.view">
        <field name="sequence" eval="25"/>
        <field name="view_mode">activity</field>
        <field name="act_window_id" ref="digiit_appraisal.action_employee_no_evaluations"/>
    </record>

    <record id="act_employee_no_evaluations_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="30"/>
        <field name="view_mode">graph</field>
        <field name="act_window_id" ref="digiit_appraisal.action_employee_no_evaluations"/>
    </record>

    <record id="act_employee_no_evaluations_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="35"/>
        <field name="view_mode">pivot</field>
        <field name="act_window_id" ref="digiit_appraisal.action_employee_no_evaluations"/>
    </record>


</odoo>