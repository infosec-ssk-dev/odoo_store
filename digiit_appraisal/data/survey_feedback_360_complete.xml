<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Enquête Feedback 360 -->
        <record id="survey_360_feedback" model="survey.survey">
            <field name="title">Feedback 360</field>
            <field name="description">Vous avez été invité à participer à un Feedback 360. Il s'agit d'une courte enquête qui permettra aux managers d'obtenir plus de retours sur un collaborateur. En travaillant avec lui/elle, vous êtes bien placé pour partager vos impressions et expliquer comment votre collaboration s'est déroulée.</field>
            <field name="access_mode">public</field>
            <field name="users_login_required">True</field>
            <field name="attempts_limit">1</field>
            <field name="is_time_limited">False</field>
            <field name="progression_mode">number</field>
            <field name="questions_layout">page_per_section</field>
            <field name="questions_selection">all</field>
            <field name="active">True</field>
            <field name="is_feedback360_template">True</field>
        </record>

        <!-- Page À propos de vous -->
        <record id="page_about_you" model="survey.question">
            <field name="title">À propos de vous</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="sequence">1</field>
            <field name="is_page">True</field>
        </record>

        <!-- Relation -->
        <record id="question_relationship" model="survey.question">
            <field name="title">Quelle est votre relation avec le/la collaborateur·rice ?</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="page_id" ref="page_about_you"/>
            <field name="sequence">3</field>
            <field name="question_type">simple_choice</field>
            <field name="constr_mandatory">True</field>
        </record>

        <record id="answer_colleague_same" model="survey.question.answer">
            <field name="question_id" ref="question_relationship"/>
            <field name="value">Nous sommes collègues, sous le même responsable.</field>
            <field name="sequence">1</field>
        </record>
        <record id="answer_colleague_different" model="survey.question.answer">
            <field name="question_id" ref="question_relationship"/>
            <field name="value">Nous sommes collègues, dans des équipes différentes.</field>
            <field name="sequence">2</field>
        </record>
        <record id="answer_management" model="survey.question.answer">
            <field name="question_id" ref="question_relationship"/>
            <field name="value">Je fais partie de son encadrement.</field>
            <field name="sequence">3</field>
        </record>
        <record id="answer_report_to" model="survey.question.answer">
            <field name="question_id" ref="question_relationship"/>
            <field name="value">Je lui fais référence hiérarchique.</field>
            <field name="sequence">4</field>
        </record>
        <record id="answer_external" model="survey.question.answer">
            <field name="question_id" ref="question_relationship"/>
            <field name="value">Je ne fais pas partie de l'entreprise.</field>
            <field name="sequence">5</field>
        </record>

        <!-- Page À propos de nous -->
        <record id="page_about_us" model="survey.question">
            <field name="title">À propos de nous</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="sequence">10</field>
            <field name="is_page">True</field>
            <field name="description">Comment ressentez-vous votre collaboration avec le/la collaborateur·rice ? Est-il/elle...</field>
        </record>

        <!-- Écoute des autres -->
        <record id="question_listening" model="survey.question">
            <field name="title">À l'écoute des autres</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="page_id" ref="page_about_us"/>
            <field name="sequence">11</field>
            <field name="question_type">simple_choice</field>
            <field name="constr_mandatory">True</field>
        </record>

        <record id="answer_listening_never" model="survey.question.answer">
            <field name="question_id" ref="question_listening"/>
            <field name="value">Jamais</field>
            <field name="sequence">1</field>
        </record>
        <record id="answer_listening_rarely" model="survey.question.answer">
            <field name="question_id" ref="question_listening"/>
            <field name="value">Rarement</field>
            <field name="sequence">2</field>
        </record>
        <record id="answer_listening_sometimes" model="survey.question.answer">
            <field name="question_id" ref="question_listening"/>
            <field name="value">Parfois</field>
            <field name="sequence">3</field>
        </record>
        <record id="answer_listening_often" model="survey.question.answer">
            <field name="question_id" ref="question_listening"/>
            <field name="value">Souvent</field>
            <field name="sequence">4</field>
        </record>
        <record id="answer_listening_almost_always" model="survey.question.answer">
            <field name="question_id" ref="question_listening"/>
            <field name="value">Presque toujours</field>
            <field name="sequence">5</field>
        </record>

        <!-- Création d'espace pour les idées -->
        <record id="question_ideas_space" model="survey.question">
            <field name="title">Crée un espace pour que différentes idées et options puissent être exprimées</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="page_id" ref="page_about_us"/>
            <field name="sequence">12</field>
            <field name="question_type">simple_choice</field>
            <field name="constr_mandatory">True</field>
        </record>

        <record id="answer_ideas_never" model="survey.question.answer">
            <field name="question_id" ref="question_ideas_space"/>
            <field name="value">Jamais</field>
            <field name="sequence">1</field>
        </record>
        <record id="answer_ideas_rarely" model="survey.question.answer">
            <field name="question_id" ref="question_ideas_space"/>
            <field name="value">Rarement</field>
            <field name="sequence">2</field>
        </record>
        <record id="answer_ideas_sometimes" model="survey.question.answer">
            <field name="question_id" ref="question_ideas_space"/>
            <field name="value">Parfois</field>
            <field name="sequence">3</field>
        </record>
        <record id="answer_ideas_often" model="survey.question.answer">
            <field name="question_id" ref="question_ideas_space"/>
            <field name="value">Souvent</field>
            <field name="sequence">4</field>
        </record>
        <record id="answer_ideas_almost_always" model="survey.question.answer">
            <field name="question_id" ref="question_ideas_space"/>
            <field name="value">Presque toujours</field>
            <field name="sequence">5</field>
        </record>

        <!-- Questions ouvertes -->
        <record id="question_improvement" model="survey.question">
            <field name="title">Que pourrait-il/elle faire pour s'améliorer dans son travail au quotidien ?</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="page_id" ref="page_about_us"/>
            <field name="sequence">20</field>
            <field name="question_type">text_box</field>
            <field name="constr_mandatory">True</field>
        </record>

        <record id="question_strength" model="survey.question">
            <field name="title">Quelle est sa plus grande force ?</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="page_id" ref="page_about_us"/>
            <field name="sequence">21</field>
            <field name="question_type">text_box</field>
            <field name="constr_mandatory">True</field>
        </record>

        <record id="question_weakness" model="survey.question">
            <field name="title">Quel est son plus grand point faible ?</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="page_id" ref="page_about_us"/>
            <field name="sequence">22</field>
            <field name="question_type">text_box</field>
            <field name="constr_mandatory">True</field>
        </record>

        <!-- Page Conclusion -->
        <record id="page_conclusion" model="survey.question">
            <field name="title">Conclusion</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="sequence">30</field>
            <field name="is_page">True</field>
        </record>

        <record id="question_final_comments" model="survey.question">
            <field name="title">Avez-vous un commentaire à lui transmettre pour l'aider à progresser ?</field>
            <field name="survey_id" ref="survey_360_feedback"/>
            <field name="page_id" ref="page_conclusion"/>
            <field name="sequence">31</field>
            <field name="question_type">text_box</field>
        </record>

    </data>
</odoo>