<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_inherit_retenu_source" model="ir.ui.view">
        <field name="name">account.payment.register.form.retenu.source</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="digiit_journal_type" invisible="1"/>
                <field
                    name="digiit_numero_document"
                    invisible="digiit_journal_type != 'bank'"
                />
                <field
                    name="digiit_clearing_date"
                    invisible="digiit_journal_type != 'bank'"
                />
                <field
                    name="digiit_source_bank_id"
                    invisible="digiit_journal_type != 'bank'"
                />
            </xpath>
        </field>
    </record>
</odoo>
