<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_inherit_retenu_source" model="ir.ui.view">
        <field name="name">account.tax.form.retenu.source</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_options']" position="inside">
                    <group string="Retenue a la Source">
                        <field name="digiit_retenu_tax"/>
                    </group>
            </xpath>
        </field>
    </record>
</odoo>
