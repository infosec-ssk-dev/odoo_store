<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retenu_source_record_tree" model="ir.ui.view">
        <field name="name">retenu.source.record.tree</field>
        <field name="model">digiit.retenu.source.record</field>
        <field name="arch" type="xml">
            <list string="Retenue a la Source" create="0">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="digiit_account_move_id"/>
                <field name="partner_id"/>
                <field name="date_reglement"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="withholding_number"/>
                <field name="withholding_base_amount"/>
                <field name="withholding_tax_amount" column_invisible="1"/>
                <field name="payment_amount"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'posted'"
                    decoration-warning="state == 'draft'"
                    decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_retenu_source_record_form" model="ir.ui.view">
        <field name="name">retenu.source.record.form</field>
        <field name="model">digiit.retenu.source.record</field>
        <field name="arch" type="xml">
            <form string="Retenue a la Source" create="0">

                <header>
                    <!-- draft → posted -->
                    <button
                        name="action_post"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <!-- posted → draft (same as payment) -->
                    <button
                        name="action_reset_to_draft_posted"
                        string="Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'posted'"
                        confirm="This will unreconcile and void the withholding journal entry. The RAS will be set to draft and can then be deleted."
                    />
                    <!-- cancel → draft -->
                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'cancel'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancel"/>
                </header>

                <sheet>
                    <!-- Smart button: journal entry (only when posted) -->
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="action_open_withholding_entry"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book"
                            invisible="state != 'posted'"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group string="General">
                            <field name="name" readonly="1"/>
                            <field name="move_type" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="payment_journal_id" readonly="state != 'draft'"/>
                            <field name="date_reglement" readonly="state != 'draft'"/>
                        </group>
                        <group string="Withholding">
                            <field name="currency_id" invisible="1"/>
                            <field name="withholding_tax_id" readonly="state != 'draft'"/>
                            <field name="withholding_base_amount" readonly="state != 'draft'"/>
                            <field name="withholding_tax_amount" invisible="1"/>
                            <field name="payment_amount" readonly="1"/>
                            <!-- Always editable except when cancelled -->
                            <field name="withholding_number" readonly="state == 'cancel'"/>
                            <field name="memo" readonly="state == 'cancel'"/>
                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="view_retenu_source_record_search" model="ir.ui.view">
        <field name="name">retenu.source.record.search</field>
        <field name="model">digiit.retenu.source.record</field>
        <field name="arch" type="xml">
            <search string="Retenue a la Source">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="withholding_number"/>
                <filter name="filter_sales" string="Customers" domain="[('move_type', '=', 'sale')]"/>
                <filter name="filter_purchases" string="Vendors" domain="[('move_type', '=', 'purchase')]"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="filter_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <record id="action_retenu_source_sales" model="ir.actions.act_window">
        <field name="name">Retenue a la Source Customers</field>
        <field name="res_model">digiit.retenu.source.record</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'sale')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_retenu_source_purchases" model="ir.actions.act_window">
        <field name="name">Retenue a la Source Vendors</field>
        <field name="res_model">digiit.retenu.source.record</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'purchase')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem
        id="menu_retenu_source_sales"
        name="Retenue a la Source"
        parent="account.menu_finance_receivables"
        sequence="90"
        action="action_retenu_source_sales"
    />

    <menuitem
        id="menu_retenu_source_purchases"
        name="Retenue a la Source"
        parent="account.menu_finance_payables"
        sequence="90"
        action="action_retenu_source_purchases"
    />
</odoo>